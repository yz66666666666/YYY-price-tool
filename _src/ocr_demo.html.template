<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>PaddleOCR 对比测试</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif; background: #f5f6fa; color: #2d3436; padding: 12px; }
  header { text-align: center; margin-bottom: 10px; }
  h1 { font-size: 20px; }
  .tag { font-size: 12px; color: #0984e3; margin-top: 2px; }
  .status { background: #dfe6e9; border-radius: 8px; padding: 10px 12px; font-size: 13px; min-height: 18px; margin-bottom: 10px; word-break: break-all; }
  .status.err { background: #ffe3e3; color: #d63031; }
  .toolbar { display: flex; gap: 8px; margin-bottom: 8px; }
  .btn { flex: 1; display: inline-block; text-align: center; background: #0984e3; color: #fff; border: none; border-radius: 8px; padding: 12px 0; font-size: 15px; cursor: pointer; }
  .btn:disabled { background: #b2bec3; }
  .btn.secondary { background: #636e72; }
  .btn.small { font-size: 13px; padding: 8px 0; }
  .btn input { display: none; }
  .modebar { margin-bottom: 8px; }
  .stage { background: #fff; border-radius: 8px; padding: 6px; box-shadow: 0 1px 4px rgba(0,0,0,.08); }
  .stage canvas { width: 100%; display: block; border-radius: 4px; }
  .result { margin-top: 10px; }
  .result .row { display: flex; justify-content: space-between; background: #fff; border-radius: 6px; padding: 8px 10px; margin-bottom: 6px; font-size: 14px; }
  .result .row .txt { font-weight: 600; }
  .result .row .conf { color: #636e72; font-size: 12px; white-space: nowrap; }
  .result .hint { font-size: 12px; color: #636e72; text-align: center; margin-top: 4px; }
  .ms { color: #b2bec3; font-size: 12px; text-align: center; margin-top: 6px; }
</style>
</head>
<body>
<header>
  <h1>PaddleOCR 对比测试</h1>
  <div class="tag">PP-OCRv4 mobile · 中文印刷体识别 · 完全离线</div>
</header>
<div id="status" class="status">正在解压识别引擎...</div>
<div class="toolbar">
  <label class="btn">选择图片<input type="file" id="file" accept="image/*"></label>
  <button id="run" class="btn" disabled>开始识别</button>
</div>
<div class="modebar">
  <button id="toggle" class="btn secondary small">模式：识别文字叠加</button>
</div>
<div class="stage"><canvas id="canvas"></canvas></div>
<div class="ms" id="elapsed"></div>
<div class="result" id="result"></div>

<script>
/* ========== 内嵌资源（构建时替换） ========== */
var ORT_JS = "__ORT_JS_JSON__";
var ORT_WASM_GZ = "__ORT_WASM_GZ_B64__";
var DET_ONNX_GZ = "__DET_ONNX_GZ_B64__";
var REC_ONNX_GZ = "__REC_ONNX_GZ_B64__";
/* 字典：与 RapidOCR 的 character_list 对齐（index0=字典首字符），解码时 id 从 1 开始 */
var DICT = __DICT_ARRAY_JSON__;

/* ========== 工具 ========== */
function $(id) { return document.getElementById(id); }
function b64ToU8(b64) {
  var bin = atob(b64);
  var n = bin.length;
  var u8 = new Uint8Array(n);
  for (var i = 0; i < n; i++) u8[i] = bin.charCodeAt(i);
  return u8;
}
function inflateGz(u8) {
  var ds = new DecompressionStream('gzip');
  var stream = new Blob([u8]).stream().pipeThrough(ds);
  return new Response(stream).arrayBuffer();
}
function setStatus(t, err) {
  var el = $("status");
  el.textContent = t;
  el.className = "status" + (err ? " err" : "");
}

/* ========== 启动：解压 wasm -> 注入 ort.js（wasm 走 blob URL + wasmPaths） ========== */
var ORT_READY = false;

async function boot() {
  try {
    setStatus("正在解压识别引擎（约 10MB）...");
    var wasmAb = await inflateGz(b64ToU8(ORT_WASM_GZ));
    var wasmUrl = URL.createObjectURL(new Blob([wasmAb], { type: 'application/wasm' }));
    setStatus("正在初始化识别内核...");
    var s = document.createElement('script');
    s.textContent = ORT_JS;
    document.body.appendChild(s);
    if (typeof ort === 'undefined') throw new Error("onnxruntime 加载失败");
    /* onnxruntime-web 在 worker 中按文件名 fetch wasm，全部映射到同一个 blob URL */
    ort.env.wasm.wasmPaths = {
      'ort-wasm.wasm': wasmUrl,
      'ort-wasm-simd.wasm': wasmUrl,
      'ort-wasm-simd-threaded.wasm': wasmUrl,
      'ort-wasm-simd-threaded.jsep.wasm': wasmUrl
    };
    ORT_READY = true;
    setStatus("识别引擎已就绪，请选择图片");
  } catch (e) {
    setStatus("初始化失败：" + e.message + "（请在较新的浏览器中打开）", true);
  }
}

/* ========== 图片与画布 ========== */
var imgEl = null, iw = 0, ih = 0;
var canvas = $("canvas"), ctx = canvas.getContext('2d');
var words = [], overlayMode = true;

$("file").addEventListener('change', function (e) {
  var f = e.target.files && e.target.files[0];
  if (!f) return;
  var url = URL.createObjectURL(f);
  var img = new Image();
  img.onload = function () {
    imgEl = img; iw = img.naturalWidth; ih = img.naturalHeight;
    canvas.width = iw; canvas.height = ih;
    drawScene();
    $("run").disabled = !ORT_READY;
    $("result").innerHTML = "";
    words = [];
  };
  img.src = url;
});

$("toggle").addEventListener('click', function () {
  overlayMode = !overlayMode;
  this.textContent = "模式：" + (overlayMode ? "识别文字叠加" : "只看原图");
  if (imgEl) drawScene();
});

function drawScene() {
  ctx.drawImage(imgEl, 0, 0, iw, ih);
  if (!overlayMode) return;
  for (var i = 0; i < words.length; i++) {
    var w = words[i];
    var bw = w.x1 - w.x0, bh = w.y1 - w.y0;
    ctx.save();
    ctx.strokeStyle = "rgba(239,68,68,.9)";
    ctx.lineWidth = 2;
    ctx.strokeRect(w.x0 - 1, w.y0 - 1, bw + 2, bh + 2);
    ctx.fillStyle = "rgba(255,255,255,.85)";
    ctx.fillRect(w.x0 - 1, w.y0 - 1, bw + 2, bh + 2);
    ctx.fillStyle = "#111";
    ctx.font = Math.max(10, Math.min(22, bh * 0.9)) + "px sans-serif";
    ctx.textAlign = "left";
    ctx.textBaseline = "middle";
    ctx.fillText(w.text, w.x0 + 2, w.y0 + bh / 2);
    ctx.restore();
  }
}

/* ========== 模型会话 ========== */
var detSession = null, recSession = null;
var detIn, detOut, recIn, recOut;

async function initSessions() {
  if (detSession) return;
  setStatus("正在加载文本检测模型...");
  detSession = await ort.InferenceSession.create(await inflateGz(b64ToU8(DET_ONNX_GZ)), { executionProviders: ['wasm'] });
  detIn = detSession.inputNames[0];
  detOut = detSession.outputNames[0];
  setStatus("正在加载文字识别模型...");
  recSession = await ort.InferenceSession.create(await inflateGz(b64ToU8(REC_ONNX_GZ)), { executionProviders: ['wasm'] });
  recIn = recSession.inputNames[0];
  recOut = recSession.outputNames[0];
}

/* ========== 文本检测 ========== */
function detPreprocess() {
  var limitSide = 736;
  var ratio = 1;
  var m = Math.min(iw, ih);
  if (m < limitSide) ratio = limitSide / m;
  var rw = Math.max(1, Math.round(iw * ratio / 32) * 32);
  var rh = Math.max(1, Math.round(ih * ratio / 32) * 32);
  var c = document.createElement('canvas'); c.width = rw; c.height = rh;
  var g = c.getContext('2d');
  g.imageSmoothingEnabled = true; g.imageSmoothingQuality = 'high';
  g.drawImage(imgEl, 0, 0, rw, rh);
  var id = g.getImageData(0, 0, rw, rh);
  var px = id.data;
  var n = rw * rh;
  var data = new Float32Array(3 * n);
  var i, r, gg, b;
  for (i = 0; i < n; i++) {
    r = px[i * 4] / 255; gg = px[i * 4 + 1] / 255; b = px[i * 4 + 2] / 255;
    data[i] = (r - 0.5) / 0.5;
    data[n + i] = (gg - 0.5) / 0.5;
    data[2 * n + i] = (b - 0.5) / 0.5;
  }
  return { tensor: new ort.Tensor('float32', data, [1, 3, rh, rw]), rw: rw, rh: rh, sx: iw / rw, sy: ih / rh };
}

function connectedComponents(pred, H, W, th) {
  var visited = new Uint8Array(H * W);
  var out = [];
  var i, j;
  for (i = 0; i < H * W; i++) {
    if (visited[i] || pred[i] <= th) continue;
    var q = new Int32Array(H * W);
    var head = 0, tail = 0;
    q[tail++] = i; visited[i] = 1;
    var sum = 0, cnt = 0;
    var x0 = W, y0 = H, x1 = -1, y1 = -1;
    while (head < tail) {
      var p = q[head++];
      var cx = p % W, cy = (p - cx) / W;
      sum += pred[p]; cnt++;
      if (cx < x0) x0 = cx; if (cx > x1) x1 = cx;
      if (cy < y0) y0 = cy; if (cy > y1) y1 = cy;
      var ny, nx, np;
      for (ny = cy - 1; ny <= cy + 1; ny++) {
        if (ny < 0 || ny >= H) continue;
        for (nx = cx - 1; nx <= cx + 1; nx++) {
          if (nx < 0 || nx >= W) continue;
          np = ny * W + nx;
          if (!visited[np] && pred[np] > th) { visited[np] = 1; q[tail++] = np; }
        }
      }
    }
    if (cnt < 9) continue;
    out.push({ x0: x0, y0: y0, x1: x1 + 1, y1: y1 + 1, score: sum / cnt });
  }
  return out;
}

async function runDet() {
  var pre = detPreprocess();
  var feeds = {};
  feeds[detIn] = pre.tensor;
  var out = await detSession.run(feeds);
  var o = out[detOut];
  var dims = o.dims;
  var oh = dims[dims.length - 2], ow = dims[dims.length - 1];
  var pred = o.data;
  var comps = connectedComponents(pred, oh, ow, 0.3);
  var boxes = [];
  for (var i = 0; i < comps.length; i++) {
    var cc = comps[i];
    if (cc.score < 0.5) continue;
    var bw = cc.x1 - cc.x0, bh = cc.y1 - cc.y0;
    if (bw < 3 || bh < 3) continue;
    var perim = 2 * (bw + bh);
    var d = perim > 0 ? (bw * bh * 1.6) / perim : 1;
    var ux0 = Math.max(0, cc.x0 - Math.ceil(d));
    var uy0 = Math.max(0, cc.y0 - Math.ceil(d));
    var ux1 = Math.min(ow, cc.x1 + Math.ceil(d));
    var uy1 = Math.min(oh, cc.y1 + Math.ceil(d));
    if (ux1 - ux0 < 3 || uy1 - uy0 < 3) continue;
    boxes.push({
      x0: ux0 * pre.sx, y0: uy0 * pre.sy,
      x1: ux1 * pre.sx, y1: uy1 * pre.sy,
      score: cc.score
    });
  }
  return boxes;
}

/* ========== 文字识别 ========== */
function cropBox(box) {
  var pad = 2;
  var c = document.createElement('canvas');
  var x0 = box.x0 - pad, y0 = box.y0 - pad;
  var w = box.x1 - box.x0 + pad * 2, h = box.y1 - box.y0 + pad * 2;
  c.width = Math.max(1, Math.round(w));
  c.height = Math.max(1, Math.round(h));
  var g = c.getContext('2d');
  g.drawImage(imgEl, x0, y0, w, h, 0, 0, c.width, c.height);
  return c;
}

async function runRec(crops) {
  var IMGH = 48;
  var maxRatio = 320 / IMGH;
  for (var i = 0; i < crops.length; i++) {
    maxRatio = Math.max(maxRatio, crops[i].width / crops[i].height);
  }
  var imgW = Math.round(IMGH * maxRatio);
  var n = crops.length;
  var chh = IMGH;
  var big = new Float32Array(n * 3 * chh * imgW);
  for (var b = 0; b < n; b++) {
    var c = crops[b];
    var ratio = c.width / c.height;
    var rw = Math.min(imgW, Math.ceil(chh * ratio));
    var cc = document.createElement('canvas'); cc.width = rw; cc.height = chh;
    var g = cc.getContext('2d');
    g.imageSmoothingEnabled = true; g.imageSmoothingQuality = 'high';
    g.drawImage(c, 0, 0, rw, chh);
    var id = g.getImageData(0, 0, rw, chh);
    var px = id.data;
    var base = b * 3 * chh * imgW;
    var y, x, src, r, gg, bl;
    for (y = 0; y < chh; y++) {
      for (x = 0; x < rw; x++) {
        src = (y * rw + x) * 4;
        r = px[src] / 255; gg = px[src + 1] / 255; bl = px[src + 2] / 255;
        big[base + y * imgW + x] = (r - 0.5) / 0.5;
        big[base + chh * imgW + y * imgW + x] = (gg - 0.5) / 0.5;
        big[base + 2 * chh * imgW + y * imgW + x] = (bl - 0.5) / 0.5;
      }
    }
  }
  var t = new ort.Tensor('float32', big, [n, 3, chh, imgW]);
  var feeds = {};
  feeds[recIn] = t;
  var out = await recSession.run(feeds);
  return out[recOut];
}

function ctcDecode(tensor) {
  var dims = tensor.dims;
  var L = dims[dims.length - 2], C = dims[dims.length - 1];
  var data = tensor.data;
  var ids = [];
  var prev = -1;
  for (var t = 0; t < L; t++) {
    var base = t * C;
    var best = 0, bestV = data[base];
    for (var c = 1; c < C; c++) {
      if (data[base + c] > bestV) { bestV = data[base + c]; best = c; }
    }
    if (best === 0) { prev = 0; continue; }
    if (best === prev) continue;
    prev = best;
    ids.push({ id: best, conf: bestV });
  }
  return ids;
}

function idsToText(ids) {
  var s = '';
  var i, id;
  for (i = 0; i < ids.length; i++) {
    id = ids[i].id;
    if (id >= 1 && id <= DICT.length) s += DICT[id - 1];
    else s += ' ';
  }
  return s;
}

/* ========== 主流程 ========== */
$("run").addEventListener('click', async function () {
  if (!imgEl) return;
  var btn = this;
  btn.disabled = true;
  $("result").innerHTML = "";
  var t0 = performance.now();
  try {
    await initSessions();
    setStatus("正在检测文字区域...");
    var boxes = await runDet();
    if (!boxes.length) {
      setStatus("未检测到文字区域", true);
      return;
    }
    boxes.sort(function (a, b) { return a.y0 - b.y0 || a.x0 - b.x0; });
    setStatus("正在识别文字内容（" + boxes.length + " 个区域）...");
    var crops = [];
    for (var i = 0; i < boxes.length; i++) crops.push(cropBox(boxes[i]));
    var out = await runRec(crops);
    var resultEl = $("result");
    words = [];
    for (var b = 0; b < boxes.length; b++) {
      var ids = ctcDecode(tensorSlice(out, b));
      var text = idsToText(ids);
      var conf = 0;
      for (var k = 0; k < ids.length; k++) conf += ids[k].conf;
      conf = ids.length ? conf / ids.length : 0;
      if (!text) continue;
      words.push({ x0: boxes[b].x0, y0: boxes[b].y0, x1: boxes[b].x1, y1: boxes[b].y1, text: text });
      var row = document.createElement('div');
      row.className = 'row';
      row.innerHTML = '<span class="txt"></span><span class="conf"></span>';
      row.childNodes[0].textContent = text;
      row.childNodes[1].textContent = (conf * 100).toFixed(1) + '%';
      resultEl.appendChild(row);
    }
    drawScene();
    setStatus("识别完成：" + words.length + " 条文字");
    $("elapsed").textContent = "耗时 " + Math.round(performance.now() - t0) + " ms";
  } catch (e) {
    setStatus("识别出错：" + e.message, true);
  } finally {
    btn.disabled = false;
  }
});

function tensorSlice(t, b) {
  var dims = t.dims;
  var B = dims[0], L = dims[1], C = dims[2];
  var data = t.data;
  var out = { dims: [1, L, C], data: data.subarray ? data.subarray(b * L * C, (b + 1) * L * C) : new Float32Array(data.buffer, b * L * C * 4, L * C) };
  return out;
}

boot();
</script>
</body>
</html>
