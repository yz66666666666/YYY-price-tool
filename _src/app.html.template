/* ================= 步骤1 实时预览（识别第一张图作为样板） ================= */
async function startPreview() {
  const p = S.photos[0];
  if (!p) { toast("请先选择照片"); return; }
  if (S.engineBusy) return;
  if (p.ocrWords) {
    /* 文字已缓存：只按当前设置重新生成打码框/水印框（纯 JS，秒级，不重跑模型） */
    buildBoxes(p);
    toast("已按当前设置重新标记");
    openPreview();
    return;
  }
  if (await applyCachedOcr(p)) {
    /* 识别结果缓存命中：不加载引擎、不跑模型 */
    toast("识别结果来自本地缓存");
    openPreview();
    return;
  }
  /* 首次：才需要加载引擎并跑模型识别第一张 */
  S.engineBusy = true;
  showProc("正在识别预览图（仅第一张）…", 0);
  await yieldUi();
  let ok = false, err = "";
  try { await initEngine(); ok = true; } catch (e) { err = (e && e.message) || String(e); }
  if (!ok) {
    S.engineBusy = false;
    hideProc();
    toast(engineFailText(err));
    return;
  }
  try {
    const r = await recognizePhoto(p, 0, 1);
    showProc("识别完成，正在生成预览…", 100);
  } catch (e) {
    S.engineBusy = false;
    hideProc();
    toast("预览图识别失败：" + ((e && e.message) || e));
    return;
  }
  S.engineBusy = false;
  hideProc();
  openPreview();
}
function openPreview() {
  const p = S.photos[0];
  if (!p || !p.recognized) { toast("请先点「预览效果」识别第一张图"); return; }
  S.previewOn = true;
  $("previewWrap").classList.remove("hidden");
  renderPreview();
  toast("预览已就绪，改设置会实时刷新");
}
function closePreview() {
  S.previewOn = false;
  $("previewWrap").classList.add("hidden");
}
/* 预览渲染：以第一张图为底，按当前全部设置（打码/关键词水印/普通水印/图片水印）重绘 */
function renderPreview() {
  const p = S.photos[0];
  if (!p || !p.recognized) { closePreview(); return; }
  const s0 = S.settings;
  const mImg = s0.maskImgData || "";
  const key = [s0.maskType, s0.mosaicSize, s0.maskBlur, s0.maskSolidColor, s0.maskSolidOpacity,
    mImg.length, mImg.slice(0, 32)].join("|")
    + "|" + p.boxes.map(b => Math.round(b.x) + "," + Math.round(b.y) + "," + Math.round(b.w) + "," + Math.round(b.h)).join(";");
  /* 打码底图缓存：只有打码方式/参数或打码框变化时才重算 */
  if (!p._prevBase || p._prevKey !== key) {
    const base = document.createElement("canvas");
    base.width = p.w; base.height = p.h;
    const bg = base.getContext("2d");
    bg.drawImage(p.img, 0, 0);
    for (const b of p.boxes) { if (b.skip) continue; applyMaskWorld(bg, base, b.x, b.y, b.w, b.h); }
    p._prevBase = base;
    p._prevKey = key;
  }
  const wrap = $("previewCanvas");
  const cw = Math.max(160, Math.min(520, Math.floor(wrap.parentElement.clientWidth)));
  const ratio = cw / p.w;
  const ch = Math.max(100, Math.floor(p.h * ratio));
  wrap.width = cw; wrap.height = ch;
  const g = wrap.getContext("2d");
  g.imageSmoothingEnabled = true;
  g.drawImage(p._prevBase, 0, 0, cw, ch);
  /* 水印层：世界坐标绘制，通过 scale 自动换算到预览画布 */
  g.save();
  g.scale(ratio, ratio);
  const s = S.settings;
  if (s.kw && s.kw.wmEnabled && p.kwWmBoxes && p.kwWmBoxes.length) {
    const kwT = s.kw.wmType === "image" ? "image" : "text";
    const kwReady = kwT === "image" ? imgReady(S.kwWmImgEl, s.kw.wmImgData || "") : !!((s.kw.wmText || "").trim());
    if (kwReady) {
      for (const b of p.kwWmBoxes) {
        if (!kwWmBoxValid(b)) continue;
        if (kwT === "image") drawKwImageWatermark(g, b, b.k, s.kw);
        else drawKwTextWatermark(g, b, b.k, s.kw);
      }
    }
  }
  if (s.wm.enabled && s.wm.text.trim()) drawWatermarkWorld(g, p.w, p.h, s.wm);
  if (s.wmImg.enabled && imgReady(S.wmImgEl, s.wmImg.data)) drawImageWatermarkWorld(g, p.w, p.h, s.wmImg);
  g.restore();
}

/* ================= 方案系统（可动态增删，名称可自定义） ================= */
const SCHEME_KEY = "price-tool-schemes";
const MAX_SCHEMES = 20;
const DEFAULT_SCHEME_NAMES = ["方案一", "方案二", "方案三"];
let schemeNames = DEFAULT_SCHEME_NAMES.slice();
let schemes = [null, null, null];
let curScheme = 0;
function loadSchemes() {
  try {
    const saved = JSON.parse(localStorage.getItem(SCHEME_KEY));
    if (saved) {
      if (Array.isArray(saved.schemes)) {
        schemes = saved.schemes.map(s => s || null);
        if (Array.isArray(saved.names) && saved.names.length === schemes.length) {
          schemeNames = saved.names.slice();
        }
      }
      curScheme = (saved.cur >= 0 && saved.cur < schemes.length) ? saved.cur : 0;
    }
  } catch (e) {}
  if (!schemes.length) { schemes = [null]; schemeNames = ["方案一"]; }
}
function saveSchemes() {
  try { localStorage.setItem(SCHEME_KEY, JSON.stringify({ schemes, cur: curScheme, names: schemeNames })); } catch (e) {}
}
function applyScheme(i) {
  curScheme = i;
  S.settings = mergeSettings(schemes[i]);
  saveSettings();
  /* 关键：图片必须跟着方案一起换。漏掉这一步会导致「改一个方案的图，别的方案也跟着变」 */
  loadImageEls();
  updateSettingsUI();
  renderSchemeBtns();
  saveSchemes();
  toast("已切换到" + schemeNames[i]);
}
function saveCurrentScheme() {
  schemes[curScheme] = JSON.parse(JSON.stringify(S.settings));
  saveSchemes();
  renderSchemeBtns();
  toast("已保存到" + schemeNames[curScheme]);
}
function renderSchemeBtns() {
  const wrap = $("schemeBtns");
  wrap.innerHTML = "";
  schemes.forEach((s, i) => {
    const b = document.createElement("button");
    b.className = "btn sec" + (i === curScheme ? " on" : "");
    b.textContent = schemeNames[i] + (s ? " ✓" : "");
    b.onclick = () => applyScheme(i);
    wrap.appendChild(b);
  });
}
function addScheme() {
  if (schemes.length >= MAX_SCHEMES) { toast("方案最多 " + MAX_SCHEMES + " 个"); return; }
  schemes.push(null);
  schemeNames.push("方案" + (schemes.length));
  renderSchemeBtns();
  saveSchemes();
  toast("已新增方案" + schemeNames[schemes.length - 1]);
}
function deleteScheme() {
  if (schemes.length <= 1) { toast("至少保留一个方案"); return; }
  schemes.splice(curScheme, 1);
  schemeNames.splice(curScheme, 1);
  if (curScheme >= schemes.length) curScheme = schemes.length - 1;
  saveSchemes();
  renderSchemeBtns();
  toast("已删除方案");
}
function openRename() {
  const wrap = $("renameRows");
  wrap.innerHTML = "";
  schemes.forEach((s, i) => {
    const row = document.createElement("div");
    row.className = "set";
    const lb = document.createElement("label");
    lb.textContent = "方案 " + (i + 1);
    const inp = document.createElement("input");
    inp.type = "text"; inp.maxLength = 12;
    inp.id = "rename" + i;
    inp.value = schemeNames[i];
    row.appendChild(lb); row.appendChild(inp);
    wrap.appendChild(row);
  });
  $("renameModal").classList.remove("hidden");
}
function closeRename() { $("renameModal").classList.add("hidden"); }
function saveRename() {
  for (let i = 0; i < schemes.length; i++) {
    const el = document.getElementById("rename" + i);
    if (!el) continue;
    const v = el.value.trim();
    if (v) schemeNames[i] = v;
  }
  saveSchemes();
  renderSchemeBtns();
  closeRename();
  toast("方案名称已更新");
}
/* 复制当前方案的设置到其他方案 */
function openCopy() {
  $("copyDesc").textContent = "把「" + schemeNames[curScheme] + "」的设置复制到（已有内容将被覆盖）：";
  const wrap = $("copyTargets");
  wrap.innerHTML = "";
  schemes.forEach((s, i) => {
    if (i === curScheme) return;
    const row = document.createElement("div");
    row.className = "kw-row";
    row.dataset.idx = i;
    const chk = document.createElement("input");
    chk.type = "checkbox"; chk.checked = true;
    const nm = document.createElement("span");
    nm.className = "kw-txt";
    nm.textContent = schemeNames[i] + (s ? "（已有内容）" : "");
    row.appendChild(chk); row.appendChild(nm);
    wrap.appendChild(row);
  });
  $("copyModal").classList.remove("hidden");
}
function closeCopy() { $("copyModal").classList.add("hidden"); }
function confirmCopy() {
  const source = JSON.parse(JSON.stringify(S.settings));
  let n = 0;
  document.querySelectorAll("#copyTargets .kw-row").forEach(row => {
    if (!row.querySelector("input").checked) return;
    schemes[+row.dataset.idx] = JSON.parse(JSON.stringify(source));
    n++;
  });
  if (!n) { closeCopy(); return; }
  saveSchemes();
  renderSchemeBtns();
  closeCopy();
  toast("已复制到 " + n + " 个方案");
}
/* 导出当前全部设置（含方案），便于换机迁移或设为默认 */
/* mode: "lite"=仅文字设置（不含图片，文本小）；"full"=完整备份（含三张图片 dataURL） */
function stripImgs(s) {
  if (!s) return s;
  if (s.wmImg) s.wmImg.data = "";
  if (s.kw) s.kw.wmImgData = "";
  s.maskImgData = "";
  return s;
}
function buildExportData(mode) {
  if (mode !== "lite") {
    return { settings: S.settings, schemes, curScheme, schemeNames, exportMode: mode };
  }
  /* 仅设置：当前方案 + 其他所有方案里的图片 dataURL 全部清空 */
  const settings = stripImgs(JSON.parse(JSON.stringify(S.settings)));
  const s2 = JSON.parse(JSON.stringify(schemes)).map(stripImgs);
  return { settings, schemes: s2, curScheme, schemeNames, exportMode: mode };
}
function refreshExportText() {
  $("exportText").value = JSON.stringify(buildExportData($("exportMode").value));
}
function openExport() {
  refreshExportText();
  $("exportModal").classList.remove("hidden");
}
function closeExport() { $("exportModal").classList.add("hidden"); }
/* 把导出内容存成 .json 文件下载：手机上复制超长文本困难，下载文件后直接发文件即可 */
function downloadExport() {
  const mode = $("exportMode").value;
  const text = JSON.stringify(buildExportData(mode));
  const blob = new Blob([text], { type: "application/json" });
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = (mode === "lite" ? "价格打码设置" : "价格打码完整备份") + "_" + TOOL_VER + ".json";
  document.body.appendChild(a);
  a.click();
  setTimeout(() => { document.body.removeChild(a); URL.revokeObjectURL(url); }, 500);
  toast("文件已生成，请把文件发给我");
}
function copyExport() {
  const t = $("exportText");
  t.focus(); t.select();
  try {
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(t.value).then(() => toast("已复制，请粘贴发给我"))
        .catch(() => { try { document.execCommand("copy"); toast("已复制，请粘贴发给我"); } catch (e) { toast("请长按文本手动复制"); } });
    } else {
      document.execCommand("copy");
      toast("已复制，请粘贴发给我");
    }
  } catch (e) { toast("请长按文本手动复制"); }
}
/* 恢复设置里保存的三张图片（图片水印/关键词水印图/打码素材）
   —— 三张图必须与「当前方案」严格对应：设置里没有图 → 立刻清空，绝不能留着上一个方案的图。
   图片没变时直接复用已解码的 <img>，切换方案零延迟、不闪烁；变了才重新解码。
   用 gen 标记本次加载：解码是异步的，期间用户又切了方案的话，旧的 onload 结果会被丢弃，
   不会把上一个方案的图错装到当前方案上。 */
let _imgGen = 0;
const _imgElCache = { wmImg: {}, kwWmImg: {}, maskImg: {} };   // kind -> { dataURL: 已解码的 <img> }
const MAX_DECODED = 4;   // 每类图最多记住 4 张已解码的图，防止方案多时内存膨胀（手机上尤其要紧）
/* 记住一张已解码的图；超过上限就丢掉最久没用到的 */
function _putDecoded(kind, data, el) {
  const box = _imgElCache[kind];
  box[data] = el;
  const keys = Object.keys(box);
  if (keys.length > MAX_DECODED) delete box[keys[0]];   // 对象保留插入顺序，第一个就是最旧的
}
/* 取出某张图已解码的 <img>：先在解码缓存里找，再退而用当前正在用的那个 */
function _pickDecoded(kind, data, curEl) {
  const hit = _imgElCache[kind][data];
  if (hit && hit.complete) return hit;
  if (curEl && curEl.complete && curEl.src === data) return curEl;
  return null;
}
function loadOneImg(kind, data, assign, curEl) {
  if (!data) {                       // 当前方案没有这张图：清空，避免沿用上一个方案的图
    assign(null);
    return;
  }
  const ready = _pickDecoded(kind, data, curEl);
  if (ready) { assign(ready); return; }        // 已经解码过：立刻可用，切方案零延迟
  assign(null);                                 // 换了图：先清空，解码期间绝不画上一张图
  const el = new Image();
  const gen = _imgGen;
  el.onload = () => {
    if (gen !== _imgGen) return;     // 加载期间方案已切换，丢弃这次结果
    _putDecoded(kind, data, el);
    assign(el);
  };
  el.src = data;
}
function loadImageEls() {
  _imgGen++;
  const s = S.settings || {};
  /* 恢复已保存的图片水印 */
  loadOneImg("wmImg", (s.wmImg && s.wmImg.data) || "", el => { S.wmImgEl = el; updateWmImgPreview(); }, S.wmImgEl);
  /* 恢复已保存的关键词水印独立图片 */
  loadOneImg("kwWmImg", (s.kw && s.kw.wmImgData) || "", el => { S.kwWmImgEl = el; updateKwWmImgPreview(); }, S.kwWmImgEl);
  /* 恢复已保存的打码素材图 */
  loadOneImg("maskImg", s.maskImgData || "", el => { S.maskImgEl = el; updateMaskImgPreview(); }, S.maskImgEl);
}
/* 图片是否已解码可用：绘制前用它兜底，保证画出来的图就是当前方案里的图 */
function imgReady(el, data) { return !!(el && data && el.complete && el.src === data); }
/* 导入设置：换浏览器/换手机后粘贴导出内容恢复 */
function openImport() {
  $("importText").value = "";
  $("importModal").classList.remove("hidden");
}
function closeImport() { $("importModal").classList.add("hidden"); }
/* 读取用户选择的 .json 导出文件并导入（免复制粘贴） */
function importFromFile() {
  const inp = $("importFileInput");
  const f = inp.files && inp.files[0];
  if (!f) return;
  const rd = new FileReader();
  rd.onload = () => { $("importText").value = rd.result; doImport(); inp.value = ""; };
  rd.onerror = () => toast("文件读取失败");
  rd.readAsText(f, "utf-8");
}
function doImport() {
  const raw = ($("importText").value || "").trim();
  if (!raw) { toast("请先粘贴导出的内容"); return; }
  let data;
  try { data = JSON.parse(raw); } catch (e) { toast("内容不是有效的导出数据"); return; }
  if (!data || typeof data !== "object" || !data.settings) { toast("格式不对，请粘贴「⬇ 导出」复制的内容"); return; }
  try {
    const ds = data.settings || {};
    const hasImg = !!(ds.wmImg && ds.wmImg.data) || !!(ds.kw && ds.kw.wmImgData) || !!ds.maskImgData;
    S.settings = mergeSettings(ds);
    if (!hasImg) {
      /* 轻量导出不含图片：清掉本地残留图片，避免误用旧图 */
      if (S.settings.wmImg) S.settings.wmImg.data = "";
      if (S.settings.kw) S.settings.kw.wmImgData = "";
      S.settings.maskImgData = "";
      S.wmImgEl = null; S.kwWmImgEl = null; S.maskImgEl = null;
      /* 换了一整套设置，解码缓存整体作废，避免误用旧图 */
      _imgElCache.wmImg = {}; _imgElCache.kwWmImg = {}; _imgElCache.maskImg = {};
    }
    if (Array.isArray(data.schemes)) {
      schemes = data.schemes.map(s => s || null);
      if (schemes.length) {
        if (Array.isArray(data.schemeNames) && data.schemeNames.length === schemes.length) schemeNames = data.schemeNames.slice();
        else if (schemeNames.length !== schemes.length) schemeNames = schemes.map((s, i) => "方案" + (i + 1));
      }
    }
    if (typeof data.curScheme === "number" && data.curScheme >= 0 && data.curScheme < schemes.length) curScheme = data.curScheme;
    saveSettings();
    saveSchemes();
    loadImageEls();
    updateSettingsUI();
    renderSchemeBtns();
    toast(hasImg ? "导入成功，设置已恢复（含图片）" : "导入成功。图片水印/关键词水印图/打码素材需重新上传");
    closeImport();
  } catch (e) {
    toast("导入失败：" + ((e && e.message) || e));
  }
}

/* ================= 输出渲染与保存 ================= */
function renderOutput(p) {
  const out = document.createElement("canvas");
  out.width = p.w; out.height = p.h;
  const g = out.getContext("2d");
  g.drawImage(p.img, 0, 0);
  for (const b of p.boxes) {
    if (b.skip) continue;
    applyMaskWorld(g, out, b.x, b.y, b.w, b.h);
  }
  /* 识别文字位置打水印：位置=全部识别文字/连续数字串，水印类型在下方折叠面板选 */
  const wmo = S.settings.wmOcr;
  const kw = S.settings.kw;
  if (p.ocrWords && p.ocrWords.length) {
    /* 关键词水印：用识别时生成的水印框（微调页可拖动微调位置） */
    if (kw && kw.wmEnabled) {
      const kwType = kw.wmType === "image" ? "image" : "text";
      const kwReady = kwType === "image" ? !!kw.wmImgData : !!((kw.wmText || "").trim());
      if (kwReady && p.kwWmBoxes && p.kwWmBoxes.length) {
        for (const b of p.kwWmBoxes) {
          if (!kwWmBoxValid(b)) continue;
          if (kwType === "image") drawKwImageWatermark(g, b, b.k, kw);
          else drawKwTextWatermark(g, b, b.k, kw);
        }
      }
    }
    /* 识别文字位置打水印：全部识别文字 / 连续数字串（订单号） */
    if (wmo && wmo.enabled) {
      const wmType = (wmo.type === "image" && imgReady(S.wmImgEl, S.settings.wmImg.data)) ? "image" : "text";
      const wmReady = wmType === "image" || !!S.settings.wm.text.trim();
      if (wmReady) {
        for (const ln of p.ocrWords) {
          const digits = (ln.text || "").replace(/[^0-9]/g, "");
          const hit = wmo.allText || (wmo.orderNo && digits.length >= wmo.minLen);
          if (!hit) continue;
          drawBoxWm(g, ln, wmType);
        }
      }
    }
  }
  if (S.settings.wm.enabled && S.settings.wm.text.trim()) {
    drawWatermarkWorld(g, p.w, p.h, S.settings.wm);
  }
  if (S.settings.wmImg.enabled && S.settings.wmImg.data) {
    drawImageWatermarkWorld(g, p.w, p.h, S.settings.wmImg);
  }
  return out;
}
/* 关键词水印独立位置偏移：默认盖在关键词正中；方向 top/bottom/left/right 按框尺寸的百分比偏离 */
function kwWmOffset(k, box) {
  let dx = 0, dy = 0;
  if (!k) return { dx, dy };
  const dir = k.wmPosDir || "center";
  const d = (k.wmPosDist != null ? k.wmPosDist : 0) / 100;
  if (dir === "top") dy = -box.h * d;
  else if (dir === "bottom") dy = box.h * d;
  else if (dir === "left") dx = -box.w * d;
  else if (dir === "right") dx = box.w * d;
  return { dx, dy };
}
/* 关键词水印框是否仍有效：对应关键词还在列表里且水印开关开着 */
function kwWmBoxValid(b) {
  const k = b.k;
  return !!k && k.wm && S.settings.kw.list.indexOf(k) >= 0;
}
/* 关键词水印：文字版——字号=框高×百分比，颜色/透明度用关键词水印自己的设置 */
function drawKwTextWatermark(g, box, k, gkw) {
  const base = (gkw.wmText || "").trim();
  if (!base || box.w < 8 || box.h < 8) return;
  const wmSize = k && k.wmSize != null ? k.wmSize : (gkw.wmSize != null ? gkw.wmSize : 60);
  const fs = Math.max(8, box.h * wmSize / 100);
  g.font = "bold " + fs + "px sans-serif";
  const oneW = Math.max(1, g.measureText(base + "  ").width);
  const cnt = Math.max(1, Math.floor((box.w * 0.9) / oneW));
  const label = cnt > 1 ? new Array(cnt).fill(base).join("  ") : base;
  g.save();
  g.globalAlpha = gkw.wmOpacity != null ? gkw.wmOpacity : 0.8;
  g.fillStyle = gkw.wmColor || "#ffffff";
  g.font = "bold " + fs + "px sans-serif";
  g.textAlign = "center"; g.textBaseline = "middle";
  const off = kwWmOffset(k, box);
  g.translate(box.x + box.w / 2 + off.dx, box.y + box.h / 2 + off.dy);
  if (gkw.wmAngle) g.rotate(gkw.wmAngle * Math.PI / 180);
  g.fillText(label, 0, 0);
  g.restore();
}
/* 关键词水印：图片版——用关键词水印自己上传的图片，等比缩放至框的百分比大小，居中 */
function drawKwImageWatermark(g, box, k, gkw) {
  const img = S.kwWmImgEl;
  const kwData = (S.settings.kw && S.settings.kw.wmImgData) || "";
  if (box.w < 8 || box.h < 8 || !imgReady(img, kwData)) return;
  const wmSize = k && k.wmSize != null ? k.wmSize : (gkw.wmImgSize != null ? gkw.wmImgSize : 80);
  const pct = wmSize / 100;
  const maxW = box.w * pct, maxH = box.h * pct;
  const r = Math.min(maxW / img.width, maxH / img.height);
  const dw = img.width * r, dh = img.height * r;
  g.save();
  g.globalAlpha = gkw.wmImgOpacity != null ? gkw.wmImgOpacity : 0.8;
  const off = kwWmOffset(k, box);
  g.translate(box.x + box.w / 2 + off.dx, box.y + box.h / 2 + off.dy);
  if (gkw.wmAngle) g.rotate(gkw.wmAngle * Math.PI / 180);
  g.drawImage(img, -dw / 2, -dh / 2, dw, dh);
  g.restore();
}
/* 按水印类型在框内盖水印（文字或图片）——「识别文字位置打水印」使用 */
function drawBoxWm(g, box, type) {
  if (type === "image") drawBoxImageWatermark(g, box);
  else drawBoxWatermark(g, box, S.settings.wm);
}
/* 在指定框内盖图片水印：按框大小等比缩放并居中 */
function drawBoxImageWatermark(g, box) {
  const img = S.wmImgEl;
  const data = (S.settings.wmImg && S.settings.wmImg.data) || "";
  if (box.w < 8 || box.h < 8 || !imgReady(img, data)) return;
  const r = Math.min(box.w / img.width, box.h / img.height);
  const dw = img.width * r, dh = img.height * r;
  g.save();
  g.globalAlpha = S.settings.wmImg.opacity;
  g.drawImage(img, box.x + (box.w - dw) / 2, box.y + (box.h - dh) / 2, dw, dh);
  g.restore();
}
/* 在指定文字框内盖水印文字：文字自动重复铺满整行，字号按框高自适应 */
function drawBoxWatermark(g, ln, wm) {
  if (ln.w < 8 || ln.h < 8) return;
  const base = wm.text;
  const fs = Math.max(10, Math.min(ln.h * 0.75, (ln.w * 1.6) / (base.length + 1)));
  g.font = "bold " + fs + "px sans-serif";
  const oneW = Math.max(1, g.measureText(base + "  ").width);
  const cnt = Math.max(1, Math.floor((ln.w * 0.9) / oneW));
  const label = cnt > 1 ? new Array(cnt).fill(base).join("  ") : base;
  g.save();
  g.globalAlpha = wm.opacity;
  g.fillStyle = wm.color;
  g.font = "bold " + fs + "px sans-serif";
  g.textAlign = "center"; g.textBaseline = "middle";
  g.translate(ln.x + ln.w / 2, ln.y + ln.h / 2);
  if (wm.angle) g.rotate(wm.angle * Math.PI / 180);
  g.fillText(label, 0, 0);
  g.restore();
}
function mosaicWorld(g, src, x, y, w, h, bs) {
  x = Math.max(0, Math.floor(x)); y = Math.max(0, Math.floor(y));
  w = Math.min(w, src.width - x); h = Math.min(h, src.height - y);
  if (w <= 0 || h <= 0) return;
  g.save();
  g.beginPath();
  g.rect(x, y, w, h);
  g.clip();
  g.imageSmoothingEnabled = false;
  const cols = Math.max(1, Math.round(w / bs));
  const rows = Math.max(1, Math.round(h / bs));
  g.drawImage(src, x, y, w, h, x, y, cols, rows);
  g.drawImage(g.canvas, x, y, cols, rows, x, y, w, h);
  g.restore();
}
/* 打码渲染（世界坐标版，输出图/预览底图共用）：blur=高斯模糊 / solid=纯色块 / img=图片素材 / mosaic=马赛克 */
function applyMaskWorld(g, src, x, y, w, h) {
  const s = S.settings;
  const t = s.maskType || "mosaic";
  if (t === "blur" && FILTER_OK) {
    const r = Math.max(1, s.maskBlur != null ? s.maskBlur : 12);
    try {
      g.save();
      g.filter = "blur(" + r + "px)";
      g.beginPath();
      g.rect(x, y, w, h);
      g.clip();
      g.drawImage(src, x, y, w, h, x, y, w, h);
      g.restore();
      return;
    } catch (e) { try { g.restore(); } catch (e2) {} }
  }
  if (t === "solid") {
    g.save();
    g.globalAlpha = s.maskSolidOpacity != null ? s.maskSolidOpacity : 1;
    g.fillStyle = s.maskSolidColor || "#000000";
    g.fillRect(x, y, w, h);
    g.restore();
    return;
  }
  if (t === "img" && imgReady(S.maskImgEl, s.maskImgData)) {
    const img = S.maskImgEl;
    /* 要多大就裁多大：按打码框的真实大小从素材里裁一块，放大框=裁更大的区域 */
    let cw = w, ch = h;
    if (cw > img.width || ch > img.height) {   // 素材不够大时整体拉伸（保持框的比例）
      const sc = Math.max(cw / img.width, ch / img.height);
      cw = Math.round(cw / sc); ch = Math.round(ch / sc);
    }
    g.save();
    g.beginPath();
    g.rect(x, y, w, h);
    g.clip();
    g.drawImage(img, (img.width - cw) / 2, (img.height - ch) / 2, cw, ch, x, y, w, h);
    g.restore();
    return;
  }
  mosaicWorld(g, src, x, y, w, h, s.mosaicSize);
}
function outName(p) {
  const base = (p.name || "photo").replace(/\.[^.]+$/, "");
  return base + "_打码水印.png";
}
function downloadBlob(blob, name) {
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url; a.download = name;
  document.body.appendChild(a);
  a.click();
  a.remove();
  setTimeout(() => URL.revokeObjectURL(url), 15000);
}
/* ================= ZIP 打包（store 不压缩，PNG 本身已压缩）================= */
/* 手机浏览器限制连续逐张下载（如 vivo 每 1 分钟约 3 次），张数多时打包成一个 zip 只下载一次，绕开限制 */
function crc32(u8) {
  let c = ~0;
  for (let i = 0; i < u8.length; i++) {
    c ^= u8[i];
    for (let k = 0; k < 8; k++) c = (c >>> 1) ^ (0xEDB88320 & -(c & 1));
  }
  return (~c) >>> 0;
}
function zipMake(files) {   // files: [{name, data(Uint8Array)}] -> Blob(zip)
  const enc = new TextEncoder();
  const chunks = [], central = [];
  let offset = 0;
  const d = new Date();
  const dosTime = (d.getHours() << 11) | (d.getMinutes() << 5) | (d.getSeconds() >> 1);
  const dosDate = (((d.getFullYear() - 1980) & 0x7F) << 9) | ((d.getMonth() + 1) << 5) | d.getDate();
  for (const f of files) {
    const nameU8 = enc.encode(f.name);
    const crc = crc32(f.data);
    const lh = new DataView(new ArrayBuffer(30));
    lh.setUint32(0, 0x04034b50, true);
    lh.setUint16(4, 20, true); lh.setUint16(6, 0, true); lh.setUint16(8, 0, true);
    lh.setUint16(10, dosTime, true); lh.setUint16(12, dosDate, true);
    lh.setUint32(14, crc, true);
    lh.setUint32(18, f.data.length, true); lh.setUint32(22, f.data.length, true);
    lh.setUint16(26, nameU8.length, true); lh.setUint16(28, 0, true);
    chunks.push(lh.buffer, nameU8.buffer, f.data.buffer);
    const ch = new DataView(new ArrayBuffer(46));
    ch.setUint32(0, 0x02014b50, true);
    ch.setUint16(4, 20, true); ch.setUint16(6, 20, true);
    ch.setUint16(8, 0, true); ch.setUint16(10, 0, true);
    ch.setUint16(12, dosTime, true); ch.setUint16(14, dosDate, true);
    ch.setUint32(16, crc, true);
    ch.setUint32(20, f.data.length, true); ch.setUint32(24, f.data.length, true);
    ch.setUint16(28, nameU8.length, true); ch.setUint16(30, 0, true);
    ch.setUint16(32, 0, true); ch.setUint16(34, 0, true);
    ch.setUint16(36, 0, true); ch.setUint32(38, 0, true);
    ch.setUint32(42, offset, true);
    central.push(ch.buffer, nameU8.buffer);
    offset += 30 + nameU8.length + f.data.length;
  }
  const cdSize = central.reduce((s, c) => s + c.byteLength, 0);
  const eo = new DataView(new ArrayBuffer(22));
  eo.setUint32(0, 0x06054b50, true);
  eo.setUint16(4, 0, true); eo.setUint16(6, 0, true);
  eo.setUint16(8, files.length, true); eo.setUint16(10, files.length, true);
  eo.setUint32(12, cdSize, true); eo.setUint32(16, offset, true);
  eo.setUint16(20, 0, true);
  return new Blob([...chunks, ...central, eo], { type: "application/zip" });
}
function saveAllZip(list) {
  const n = list.length;
  openSaveModal();
  setSaveBtn("正在打包…", true);
  updateSaveProgress(0, n, "正在生成 " + n + " 张图片，请稍候…");
  (async () => {
    try {
      const files = [];
      for (let i = 0; i < n; i++) {
        const p = list[i];
        updateSaveProgress(i, n, "正在处理 " + (i + 1) + "/" + n + "：" + p.name);
        await yieldUi();
        const blob = await canvasToBlob(renderOutput(p));
        files.push({ name: outName(p), data: new Uint8Array(await blob.arrayBuffer()) });
      }
      updateSaveProgress(n, n, "正在打包成压缩包…");
      await yieldUi();
      const zip = zipMake(files);
      downloadBlob(zip, "打码图片_" + n + "张.zip");
      updateSaveProgress(n, n, "已下载压缩包（含 " + n + " 张图）。浏览器限制逐张下载，打包可一次全拿到。");
      setSaveBtn("完成", false, closeSaveModal);
      saveCtx = null;
    } catch (e) {
      updateSaveProgress(0, n, "保存出错：" + ((e && e.message) || e));
      setSaveBtn("完成", false, closeSaveModal);
      saveCtx = null;
    }
  })();
}
/* 保存进度弹窗 */
function openSaveModal() {
  $("saveModal").classList.remove("hidden");
  setSaveBtn("正在保存…", true);
  $("saveBar").style.width = "0%";
}
function updateSaveProgress(done, total, text) {
  $("saveBar").style.width = (total ? Math.round(done / total * 100) : 0) + "%";
  $("saveText").textContent = text;
}
function setSaveBtn(text, disabled, onclick) {
  const b = $("saveNextBtn");
  b.textContent = text;
  b.disabled = !!disabled;
  b.onclick = onclick || null;
}
function closeSaveModal() { $("saveModal").classList.add("hidden"); }
const sleep = (ms) => new Promise(r => setTimeout(r, ms));
/* 保存：自动分批逐张下载（每批 3 张，浏览器通常只放行 3 个连续下载）。
   每批内自动一张接一张，批与批之间由用户点「继续」触发，保证每次都放行；PNG 直接进相册/下载 */
let saveCtx = null;
async function savePhotos(list) {
  const photos = list.filter(Boolean);
  if (!photos.length) { toast("请先选择照片"); return; }
  saveCtx = { photos, i: 0, n: photos.length };
  openSaveModal();
  await runSaveBatch();
}
async function runSaveBatch() {
  const ctx = saveCtx;
  if (!ctx) return;
  const { photos, n } = ctx;
  const batch = Math.min(6, Math.max(1, S.settings.saveBatch || 3));   // 每批张数可在设置里调
  updateSaveProgress(ctx.i, n, "准备中…");
  await yieldUi();
  try {
    const batchEnd = Math.min(ctx.i + batch, n);
    for (; ctx.i < batchEnd; ctx.i++) {
      const p = photos[ctx.i];
      updateSaveProgress(ctx.i, n, "正在处理 " + (ctx.i + 1) + "/" + n + "：" + p.name);
      await yieldUi();
      const blob = await canvasToBlob(renderOutput(p));
      downloadBlob(blob, outName(p));
      updateSaveProgress(ctx.i + 1, n, "第 " + (ctx.i + 1) + "/" + n + " 张已保存" + (ctx.i + 1 < batchEnd ? "，准备下一张…" : ""));
      await yieldUi();
      if (ctx.i + 1 < batchEnd) await sleep(900);   // 批内间隔，逐个放行
    }
    if (ctx.i >= n) {
      updateSaveProgress(n, n, "全部保存完成：共 " + n + " 张");
      setSaveBtn("完成", false, closeSaveModal);
      saveCtx = null;
    } else {
      const left = n - ctx.i;
      updateSaveProgress(ctx.i, n, "已保存 " + ctx.i + "/" + n + " 张。浏览器限制连续下载，点「继续」自动保存下一批（" + Math.min(batch, left) + " 张）");
      setSaveBtn("继续保存", false, () => { setSaveBtn("正在保存…", true); runSaveBatch(); });
    }
  } catch (e) {
    updateSaveProgress(0, n, "保存出错：" + ((e && e.message) || e));
    setSaveBtn("完成", false, closeSaveModal);
    saveCtx = null;
  }
}
function saveAll() {
  const list = S.photos.filter(Boolean);
  if (!list.length) { toast("请先选择照片"); return; }
  /* 3 张及以下逐张下载直接进相册；超过 3 张打包成 zip 一次下载（vivo 等浏览器限制连续逐张下载） */
  if (list.length > 3) saveAllZip(list);
  else savePhotos(list);
}
function canvasToBlob(c) {
  return new Promise((resolve) => c.toBlob(resolve, "image/png"));
