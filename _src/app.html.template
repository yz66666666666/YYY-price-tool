function renderKwList() {
  const wrap = $("kwList");
  const list = S.settings.kw.list;
  if (!list.length) {
    wrap.innerHTML = '<span class="kw-tip">暂无关键词，可在下方添加。</span>';
    return;
  }
  wrap.innerHTML = "";
  list.forEach((kw, i) => {
    const row = document.createElement("div");
    row.className = "kw-row";
    const txt = document.createElement("span");
    txt.className = "kw-txt";
    txt.textContent = kw.text;
    const mWord = document.createElement("button");
    mWord.textContent = "词本身";
    mWord.className = "mini-btn" + (kw.mode === "word" ? " on" : "");
    mWord.onclick = () => { kw.mode = "word"; saveSettings(); renderKwList(); };
    const mLine = document.createElement("button");
    mLine.textContent = "整行";
    mLine.className = "mini-btn" + (kw.mode === "line" ? " on" : "");
    mLine.onclick = () => { kw.mode = "line"; saveSettings(); renderKwList(); };
    const bMask = document.createElement("button");
    bMask.textContent = "打码";
    bMask.className = "mini-btn" + (kw.mask !== false ? " on" : "");
    bMask.onclick = () => { kw.mask = kw.mask !== false ? false : true; saveSettings(); renderKwList(); };
    const bWm = document.createElement("button");
    bWm.textContent = "水印";
    bWm.className = "mini-btn" + (kw.wm ? " on" : "");
    bWm.onclick = () => { kw.wm = !kw.wm; saveSettings(); renderKwList(); };
    const bSet = document.createElement("button");
    bSet.textContent = "⚙";
    bSet.title = "水印独立设置（大小 / 位置偏移）";
    bSet.className = "mini-btn" + (kw.wmSize != null || kw.wmPosDir || kw.wmPosDist != null ? " on" : "");
    bSet.onclick = () => openKwWmDlg(i);
    const del = document.createElement("button");
    del.textContent = "✕";
    del.className = "mini-btn del";
    del.onclick = () => { S.settings.kw.list.splice(i, 1); saveSettings(); renderKwList(); };
    row.appendChild(txt); row.appendChild(mWord); row.appendChild(mLine);
    row.appendChild(bMask); row.appendChild(bWm); row.appendChild(bSet); row.appendChild(del);
    wrap.appendChild(row);
  });
}
