      setEngineStatus(ok ? "ready" : "err", ok ? ("SELFTEST_OK:" + text) : ("SELFTEST_LOW:" + text));
    } catch (e) {
      setEngineStatus("err", "SELFTEST_FAIL:" + (e && e.message ? e.message : e));
    }
  })();
}
</script>
</body>
</html>
