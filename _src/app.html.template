function zoomAt(factor) {
  const p = curPhoto(); if (!p) return;
  const wrap = $("canvasWrap");
  const fit = wrap.clientWidth / p.w;
  const cx = wrap.clientWidth / 2, cy = wrap.clientHeight / 2;
  const w = screenToWorld(cx, cy);
  S.zoom.scale = clamp(S.zoom.scale * factor, fit * 0.25, fit * 12);
  S.zoom.ox = cx - w.x * S.zoom.scale;
  S.zoom.oy = cy - w.y * S.zoom.scale;
}
/* 识别并打码主流程：force=true 时对全部照片重新识别（设置可能已改） */
async function runRecognition(force) {
  if (S.engineBusy) return;
  if (!S.photos.length) { toast("请先选择照片"); return; }
  S.engineBusy = true;   // 立即占用：防止引擎加载期间重复点击并发执行
  $("btnRun").disabled = true;
  setStep(2);
  $("back1").disabled = true;
  $("progressWrap").classList.remove("hidden");
  $("progressBar").style.width = "0%";
  $("progressText").textContent = "正在加载识别引擎…";
  $("recognizeResult").innerHTML = "";
  showProc("正在加载识别引擎…", 0);   // 点击后立即弹出全屏遮罩，给出即时反馈
  await yieldUi();   // 先让遮罩与步骤2界面绘制出来，避免点击后无反馈
  let engineOk = false, engineErr = "";
  try {
    await initEngine();
    engineOk = true;
  } catch (e) {
    engineErr = (e && e.message) || String(e);
  }
  if (!engineOk) {
    S.engineBusy = false;
    $("btnRun").disabled = false;
    $("back1").disabled = false;
    hideProc();
    setStep(1);
    toast(engineFailText(engineErr));
    return;
  }
  if (force) {
    S.photos.forEach(p => { p.recognized = false; p.boxes = []; p.kwWmBoxes = []; });
  } else {
    /* 已识别的照片（如预览过的那张）只按当前设置重建标记，秒级，不重跑模型 */
    S.photos.forEach(p => { if (p.recognized) buildBoxes(p); });
  }
  /* 先尝试识别结果缓存：同一张图曾识别过就直接复用文字结果，跳过模型 */
  for (const p of S.photos) {
    if (p.recognized) continue;
    try { await applyCachedOcr(p); } catch (e) {}
  }
  const photos = S.photos.filter(p => !p.recognized);
  if (!photos.length) {
    S.engineBusy = false;
    $("btnRun").disabled = false;
    $("back1").disabled = false;
    hideProc();
    closePreview();
    setStep(3);
    syncBoxList();
    return;
  }
  const total = photos.length;
  let done = 0;
  for (const p of photos) {
    /* 每张照片开始前先更新状态并让出主线程，让遮罩文字/进度实时刷新 */
    updateProc(`正在识别 ${done + 1}/${total}：${p.name}`, (done / total) * 100);
    await yieldUi();
    try {
      const r = await recognizePhoto(p, done, total);
      done++;
      $("progressBar").style.width = ((done / total) * 100) + "%";
      updateProc(`已识别 ${done}/${total}，正在处理剩余照片…`, (done / total) * 100);
      const line = document.createElement("p");
      line.className = "loading-msg";
      line.textContent = "✓ " + p.name + "：识别到 " + r.boxes.length + " 处待打码内容（" + (r.ms / 1000).toFixed(1) + " 秒）";
      const btn = document.createElement("button");
      btn.className = "mini-btn";
      btn.textContent = "📄 识别文字";
      btn.onclick = () => showOcrText(p);
      line.appendChild(btn);
      $("recognizeResult").appendChild(line);
    } catch (err) {
      const line = document.createElement("p");
      line.className = "loading-msg";
      line.style.color = "#dc2626";
      line.textContent = "✗ " + p.name + "：识别失败（" + (err.message || err) + "）";
      $("recognizeResult").appendChild(line);
      done++;
    }
  }
  $("progressBar").style.width = "100%";
  $("progressText").textContent = "识别完成，共处理 " + done + " 张";
  hideProc();
  S.engineBusy = false;
  $("btnRun").disabled = false;
  $("back1").disabled = false;
  closePreview();
  setStep(3);
  syncBoxList();
  toast("识别打码完成，已进入微调保存");
}
/* 步骤3 内：「重新标记」——文字已缓存的照片只重算框（秒级）；从未识别的照片才跑模型 */
async function rerunCurrent() {
  const p = curPhoto();
  if (!p) { toast("请先选择照片"); return; }
  if (S.engineBusy) return;
  if (p.ocrWords) {
    buildBoxes(p);
    S.boxes = p.boxes;
    resetCanvas();
    syncBoxList();
    toast("已按当前设置重新标记");
    return;
  }
  if (await applyCachedOcr(p)) {
    S.boxes = p.boxes;
    resetCanvas();
    syncBoxList();
    toast("识别结果来自本地缓存");
    return;
  }
  S.engineBusy = true;
  $("btnRerun").disabled = true;
  showProc("正在准备识别引擎…", 0);
  await yieldUi();
  try {
    await initEngine();
  } catch (e) {
    hideProc();
    S.engineBusy = false;
    $("btnRerun").disabled = false;
    toast(engineFailText(e));
    return;
  }
  updateProc(`正在识别：${p.name}`, 0);
  await yieldUi();
  let okMsg = "";
  try {
    const r = await recognizePhoto(p, 0, 1);
    p.recognized = true;
    S.boxes = p.boxes;
    resetCanvas();
    syncBoxList();
    okMsg = "识别完成，共 " + r.boxes.length + " 处待打码内容";
  } catch (err) {
    okMsg = "识别失败：" + ((err && err.message) || err);
  }
  hideProc();
  S.engineBusy = false;
  $("btnRerun").disabled = false;
  toast(okMsg);
}

