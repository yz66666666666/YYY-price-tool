/* 把一份设置快照（可含部分字段）与默认值合并成完整设置 */
function mergeSettings(src) {
  const s = JSON.parse(JSON.stringify(DEFAULTS));
  if (!src) return s;
  if (src.wm) Object.assign(s.wm, src.wm);
  if (src.wmImg) Object.assign(s.wmImg, src.wmImg);
  if (src.wmOcr) { Object.assign(s.wmOcr, src.wmOcr); if (s.wmOcr.type !== "image") s.wmOcr.type = "text"; }
  if (src.mosaicSize) s.mosaicSize = src.mosaicSize;
  if (typeof src.saveBatch === "number" && src.saveBatch >= 1 && src.saveBatch <= 6) s.saveBatch = Math.round(src.saveBatch);
  if (["blur", "mosaic", "solid", "img"].indexOf(src.maskType) >= 0) s.maskType = src.maskType;
  if (typeof src.maskBlur === "number") s.maskBlur = src.maskBlur;
  if (typeof src.maskSolidColor === "string") s.maskSolidColor = src.maskSolidColor;
  if (typeof src.maskSolidOpacity === "number") s.maskSolidOpacity = src.maskSolidOpacity;
  if (typeof src.maskImgData === "string") s.maskImgData = src.maskImgData;
  if (src.kw) {
    s.kw.enabled = src.kw.enabled !== false;
    s.kw.priceEnabled = src.kw.priceEnabled !== false;
    s.kw.wmEnabled = !!src.kw.wmEnabled;
    if (typeof src.kw.wmRange === "number") s.kw.wmRange = src.kw.wmRange;
    s.kw.wmType = src.kw.wmType === "image" ? "image" : "text";
    if (typeof src.kw.wmText === "string") s.kw.wmText = src.kw.wmText;
    if (typeof src.kw.wmSize === "number") s.kw.wmSize = src.kw.wmSize;
    if (typeof src.kw.wmColor === "string") s.kw.wmColor = src.kw.wmColor;
    if (typeof src.kw.wmOpacity === "number") s.kw.wmOpacity = src.kw.wmOpacity;
    if (typeof src.kw.wmImgSize === "number") s.kw.wmImgSize = src.kw.wmImgSize;
    if (typeof src.kw.wmImgOpacity === "number") s.kw.wmImgOpacity = src.kw.wmImgOpacity;
    if (typeof src.kw.wmImgData === "string") s.kw.wmImgData = src.kw.wmImgData;
    if (typeof src.kw.wmAngle === "number") s.kw.wmAngle = src.kw.wmAngle;
    s.kw.list = (src.kw.list || []).filter(k => k && k.text && String(k.text).trim())
      .map(k => {
        const o = { text: String(k.text).trim(), mode: k.mode === "line" ? "line" : "word",
                    mask: k.mask !== false, wm: !!k.wm };
        if (typeof k.wmSize === "number") o.wmSize = k.wmSize;
        if (["center", "top", "bottom", "left", "right"].indexOf(k.wmPosDir) >= 0) o.wmPosDir = k.wmPosDir;
        if (typeof k.wmPosDist === "number") o.wmPosDist = k.wmPosDist;
        return o;
      });
  }
  return s;
}
function loadSettings() {
  let s = mergeSettings(null);
  try {
    const saved = JSON.parse(localStorage.getItem("price-tool-settings"));
    if (saved) s = mergeSettings(saved);
