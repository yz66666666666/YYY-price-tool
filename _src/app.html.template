          if (nx < 0 || nx >= W) continue;
          const np = ny * W + nx;
          if (!visited[np] && pred[np] > th) { visited[np] = 1; q[tail++] = np; }
        }
      }
    }
    if (cnt < 9) continue;
    out.push({ x0, y0, x1: x1 + 1, y1: y1 + 1, score: sum / cnt });
  }
  return out;
}
/* 从原图裁剪检测框（带 2px 内边距） */
function paddleCrop(img, box) {
  const pad = 2;
  const c = document.createElement("canvas");
  c.width = Math.max(1, Math.round(box.x1 - box.x0 + pad * 2));
  c.height = Math.max(1, Math.round(box.y1 - box.y0 + pad * 2));
  const g = c.getContext("2d");
  g.drawImage(img, box.x0 - pad, box.y0 - pad, box.x1 - box.x0 + pad * 2, box.y1 - box.y0 + pad * 2, 0, 0, c.width, c.height);
  return c;
}
/* rec 输入：高 48、等比缩放、右补 0；批量推理 */
async function paddleRec(crops) {
  const IMGH = 48;
  let maxRatio = 320 / IMGH;
  for (const c of crops) maxRatio = Math.max(maxRatio, c.width / c.height);
  const imgW = Math.round(IMGH * maxRatio);
  const n = crops.length;
  const big = new Float32Array(n * 3 * IMGH * imgW);
  for (let b = 0; b < n; b++) {
    const c = crops[b];
    const ratio = c.width / c.height;
    const rw = Math.min(imgW, Math.ceil(IMGH * ratio));
    const cc = document.createElement("canvas"); cc.width = rw; cc.height = IMGH;
    const g = cc.getContext("2d");
    g.imageSmoothingEnabled = true; g.imageSmoothingQuality = "high";
    g.drawImage(c, 0, 0, rw, IMGH);
    const px = g.getImageData(0, 0, rw, IMGH).data;
    const base = b * 3 * IMGH * imgW;
    for (let y = 0; y < IMGH; y++) {
      for (let x = 0; x < rw; x++) {
        const src = (y * rw + x) * 4;
        big[base + y * imgW + x] = (px[src] / 255 - 0.5) / 0.5;
        big[base + IMGH * imgW + y * imgW + x] = (px[src + 1] / 255 - 0.5) / 0.5;
        big[base + 2 * IMGH * imgW + y * imgW + x] = (px[src + 2] / 255 - 0.5) / 0.5;
      }
    }
  }
  const feeds = {};
  feeds[S.recIn] = new ort.Tensor("float32", big, [n, 3, IMGH, imgW]);
  const out = await S.recSession.run(feeds);
  return out[S.recOut];
}
/* CTC 贪心解码：argmax -> 去相邻重复 -> 去 blank(0) */
function ctcDecode(tensor) {
  const dims = tensor.dims;
  const L = dims[dims.length - 2], C = dims[dims.length - 1];
  const data = tensor.data;
  const ids = [];
  let prev = -1;
  for (let t = 0; t < L; t++) {
    const base = t * C;
    let best = 0, bestV = data[base];
    for (let c = 1; c < C; c++) {
      if (data[base + c] > bestV) { bestV = data[base + c]; best = c; }
    }
    if (best === 0) { prev = 0; continue; }
    if (best === prev) continue;
    prev = best;
    ids.push({ id: best, conf: bestV });
  }
  return ids;
}
/* 字典：DICT 与 RapidOCR character_list 对齐（index0=字典首字符），解码时 id 从 1 开始 */
function idsToText(ids) {
  let s = "";
  for (const x of ids) {
    if (x.id >= 1 && x.id <= DICT.length) s += DICT[x.id - 1];
    else s += " ";
  }
  return s;
}
function tensorSlice(t, b) {
  const dims = t.dims;
  const L = dims[1], C = dims[2];
  return { dims: [1, L, C], data: t.data.subarray(b * L * C, (b + 1) * L * C) };
}
/* 整图 OCR：det -> 按行裁剪 -> rec，返回行级 [{text,x,y,w,h,score}]（原图像素坐标） */
async function paddleOcr(img, iw, ih) {
  const pre = paddleDetPreprocess(img, iw, ih);
  const feeds = {};
  feeds[S.detIn] = pre.tensor;
  const detOut = await S.detSession.run(feeds);
  const o = detOut[S.detOut];
  const dims = o.dims;
  const oh = dims[dims.length - 2], ow = dims[dims.length - 1];
  const comps = connectedComponents(o.data, oh, ow, 0.3);
  const boxes = [];
  for (const cc of comps) {
    if (cc.score < 0.5) continue;
    const bw = cc.x1 - cc.x0, bh = cc.y1 - cc.y0;
    if (bw < 3 || bh < 3) continue;
    const perim = 2 * (bw + bh);
    const d = perim > 0 ? (bw * bh * 1.6) / perim : 1;
    const ux0 = Math.max(0, cc.x0 - Math.ceil(d)), uy0 = Math.max(0, cc.y0 - Math.ceil(d));
    const ux1 = Math.min(ow, cc.x1 + Math.ceil(d)), uy1 = Math.min(oh, cc.y1 + Math.ceil(d));
    if (ux1 - ux0 < 3 || uy1 - uy0 < 3) continue;
    boxes.push({ x0: ux0 * pre.sx, y0: uy0 * pre.sy, x1: ux1 * pre.sx, y1: uy1 * pre.sy, score: cc.score });
  }
  /* 释放 det 大数组，帮助低内存手机回收 */
  o.data = null; detOut[S.detOut] = null; pre.tensor = null;
  if (!boxes.length) return [];
  boxes.sort((a, b) => a.y0 - b.y0 || a.x0 - b.x0);
  const crops = boxes.map(b => paddleCrop(img, b));
  const recOut = await paddleRec(crops);
  const lines = [];
  for (let b = 0; b < boxes.length; b++) {
    const ids = ctcDecode(tensorSlice(recOut, b));
    const text = idsToText(ids);
    if (!text) continue;
    let conf = 0;
    for (const x of ids) conf += x.conf;
    lines.push({ text, x: boxes[b].x0, y: boxes[b].y0, w: boxes[b].x1 - boxes[b].x0, h: boxes[b].y1 - boxes[b].y0, score: ids.length ? conf / ids.length : 0 });
  }
  recOut.data = null; recOut[S.recOut] = null;
  return lines;
}
async function recognizePhoto(p, idx, total) {
  const t0 = performance.now();
  $("progressText").textContent = `正在识别 ${idx + 1}/${total}：${p.name}`;
  const lines = await paddleOcr(p.img, p.w, p.h);
  ocrCachePut(p, lines);   // 写入识别结果缓存：同一张图下次直接复用
  p.ocrPasses = [{ pass: 1, scale: 1, enhance: false, lines: lines.map(l => l.text), words: lines }];
  p.ocrWords = lines;   // 行级词，供图上叠加直接使用（模型识别结果缓存）
  p.recognized = true;
  buildBoxes(p);
  return { boxes: p.boxes, ms: Math.round(performance.now() - t0) };
}
/* 用缓存/已识别出的文字行重新生成打码框和关键词水印框。
   纯 JS 逻辑，毫秒级；只有「首次识别」才需要跑模型，此后改关键词/设置只需调用本函数。 */
function buildBoxes(p) {
  const lines = p.ocrWords || [];
  /* 价格打码（¥/小数点 规则，可在设置中关闭） */
  let boxes = [];
  if (S.settings.kw && S.settings.kw.priceEnabled !== false) {
    boxes = extractPriceBoxes(lines, p.w, p.h);
  }
  /* 关键词打码（词本身或整行）；只处理用途为「打码」的关键词 */
  const kws = S.settings.kw && S.settings.kw.enabled ? S.settings.kw.list.filter(k => k && k.mask !== false) : [];
  if (kws.length) {
    const kwBoxes = extractKeywordBoxes(lines, p.w, p.h, kws);
    for (const b of kwBoxes) {
      let replaced = false;
      for (let i = 0; i < boxes.length; i++) {
        const o = boxes[i];
        const ix = Math.min(o.x + o.w, b.x + b.w) - Math.max(o.x, b.x);
        const iy = Math.min(o.y + o.h, b.y + b.h) - Math.max(o.y, b.y);
        if (ix <= 0 || iy <= 0) continue;
        const minA = Math.min(o.w * o.h, b.w * b.h);
        const ov = minA > 0 ? (ix * iy) / minA : 0;
        if (ov > 0.4) {
          /* 新框更大（如整行）则替换旧框，否则保留旧框 */
          if (b.w * b.h >= o.w * o.h) boxes[i] = b;
          replaced = true;
          break;
        }
      }
      if (!replaced) boxes.push(b);
    }
  }
  p.boxes = boxes;
  /* 关键词水印框：按当前关键词列表重建，微调页可拖动微调位置 */
  p.kwWmBoxes = [];
  const kwSt = S.settings.kw;
  if (kwSt && kwSt.wmEnabled && lines.length) {
    const wmKws = kwSt.list.filter(k => k && k.wm);
    if (wmKws.length) {
      const kwT = kwSt.wmType === "image" ? "image" : "text";
      const ready = kwT === "image" ? !!kwSt.wmImgData : !!((kwSt.wmText || "").trim());
      if (ready) {
        const kb = extractKeywordBoxes(lines, p.w, p.h, wmKws);
        const range = (kwSt.wmRange || 15) / 100;
        p.kwWmBoxes = kb.map(b => {
          const ex = b.w * range, ey = b.h * range;
          return { x: b.x - ex, y: b.y - ey, w: b.w + ex * 2, h: b.h + ey * 2, k: b.k };
        });
      }
    }
  }
  return boxes;
}
/* 把识别出的文字行画到图上对应位置（白底红框，文字压在原位置） */
function drawOcrOverlay(p, scale, ox, oy) {
  const words = p.ocrWords || [];
  if (!words.length) {
    ctx.fillStyle = "rgba(255,255,255,.9)";
    ctx.font = "14px sans-serif";
    ctx.fillText("这张图还没有识别文字，请先在步骤 1 点「开始识别并打码」", 12, 22);
    return;
  }
  for (const w of words) {
    const sx = w.x * scale + ox, sy = w.y * scale + oy;
    const sw = w.w * scale, sh = w.h * scale;
    if (sx + sw < 0 || sy + sh < 0 || sx > canvas.width || sy > canvas.height) continue;
    ctx.save();
    ctx.beginPath();
    ctx.rect(sx - 1, sy - 1, sw + 2, sh + 2);
    ctx.clip();
    ctx.fillStyle = "rgba(255,255,255,.85)";
    ctx.fillRect(sx - 1, sy - 1, sw + 2, sh + 2);
    ctx.fillStyle = "#111111";
    ctx.font = Math.max(8, sh * 0.85) + "px sans-serif";
    ctx.textAlign = "left";
    ctx.textBaseline = "middle";
    ctx.fillText(w.text, sx + 1, sy + sh / 2 + 1);
    ctx.restore();
    ctx.strokeStyle = "rgba(239,68,68,.85)";
    ctx.lineWidth = 1;
    ctx.strokeRect(sx - 1.5, sy - 1.5, sw + 3, sh + 3);
  }
  // 顶部提示
  const hint = "识别文字模式 · 红框=识别出的文字行 · 点「🔤 识别文字」关闭";
  ctx.font = "12px sans-serif";
  const tw = ctx.measureText(hint).width + 24;
  ctx.fillStyle = "rgba(0,0,0,.6)";
  ctx.fillRect(8, 8, tw, 24);
  ctx.fillStyle = "#ffffff";
  ctx.textAlign = "left";
  ctx.textBaseline = "middle";
  ctx.fillText(hint, 18, 20);
}
/* 弹出查看某张照片的 OCR 识别文字（两遍结果分行展示） */
function showOcrText(p) {
  const body = $("ocrBody"), title = $("ocrTitle");
  if (!p) { toast("请先选择一张照片"); return; }
  title.textContent = "OCR 识别文字：" + p.name;
  if (!p.ocrPasses || !p.ocrPasses.length) {
    body.innerHTML = '<span class="ph">这张图还没有识别记录，请先在步骤 1 点「开始识别并打码」。</span>';
  } else {
    const parts = [];
    for (const pass of p.ocrPasses) {
      const tag = "PaddleOCR 识别结果";
      parts.push("—— " + tag + " ——");
      parts.push(pass.lines.length ? pass.lines.join("\n") : "（未识别出文字）");
      parts.push("");
    }
    body.textContent = parts.join("\n");
  }
  $("ocrOverlay").classList.remove("hidden");
}
function closeOcrText() { $("ocrOverlay").classList.add("hidden"); }

/* ================= 步骤流程 ================= */
function setStep(n) {
  S.step = n;
  for (let i = 1; i <= 3; i++) $("sec" + i).classList.toggle("hidden", i !== n);
  document.querySelectorAll(".steps .step").forEach((el, i) => el.classList.toggle("active", i + 1 === n));
  if (n === 3) {
    S.cur = Math.max(0, S.cur);
    renderTabs();
    S.boxes = curPhoto().boxes;
    resetCanvas();
  }
  window.scrollTo(0, 0);
}
function renderTabs() {
  const wrap = $("photoTabs");
  wrap.innerHTML = "";
  S.photos.forEach((p, i) => {
    const d = document.createElement("div");
    d.className = "th" + (i === S.cur ? " cur" : "");
    const n = p.boxes.filter(b => !b.skip).length;
    d.innerHTML = `<img src="${p.img.src}"><div class="tag">${n ? n + " 处" : "未框"}</div>`;
    d.onclick = () => { S.cur = i; S.boxes = p.boxes; renderTabs(); resetCanvas(); syncBoxList(); };
    wrap.appendChild(d);
  });
}
function syncBoxList() {
  const p = curPhoto();
  const wrap = $("boxList");
  if (!p) { wrap.innerHTML = ""; return; }
  wrap.innerHTML = `<p class="loading-msg" style="margin:0 0 6px;">共 ${p.boxes.filter(b=>!b.skip).length} 个价格框（点击勾选框可临时不参与打码）</p>`;
  p.boxes.forEach((b, i) => {
    const d = document.createElement("div");
    d.className = "bi";
    d.innerHTML = `<input type="checkbox" class="chk" ${b.skip ? "" : "checked"}>
      <span class="nm">${b.label ? b.label : "手动框 " + (i + 1)}</span>
      <span class="sz">${Math.round(b.w)}×${Math.round(b.h)}</span>`;
    d.querySelector(".chk").onchange = (e) => { b.skip = !e.target.checked; draw(); };
    d.onclick = (e) => { if (e.target.tagName === "INPUT") return; S.sel = i; draw(); };
    wrap.appendChild(d);
  });
}
