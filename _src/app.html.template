/* base64 转字节：分块解码，每段让出主线程，避免大字符串解码卡死界面 */
async function b64ToBytes(b64) {
  const u8 = new Uint8Array(Math.floor(b64.length * 3 / 4));
  const CHUNK = 1 << 22;   // 每段 4M base64 字符
  let off = 0;
  for (let p = 0; p < b64.length; p += CHUNK) {
    const bin = atob(b64.slice(p, p + CHUNK));
    for (let i = 0; i < bin.length; i++) u8[off++] = bin.charCodeAt(i);
    if (p + CHUNK < b64.length) await new Promise(r => setTimeout(r, 0));
  }
  return u8;
}
/* ================= 引擎初始化（完全离线，PaddleOCR） ================= */
function inflateGz(u8) {
  const ds = new DecompressionStream("gzip");
  const stream = new Blob([u8]).stream().pipeThrough(ds);
  return new Response(stream).arrayBuffer();
}
/* ===== 模型本地缓存：解压一次存入 IndexedDB，之后直接读，跳过耗时的 base64 解码 ===== */
const MODEL_DB_NAME = "price-tool-model-cache";
const MODEL_DB_VER = 2;   // v2 起新增 ocr 存储区（识别结果缓存）
const MODEL_CACHE_VER = "v1";   // 内置模型更新时改为 v2，触发重新缓存
function openModelDB() {
  return new Promise((resolve, reject) => {
    const req = indexedDB.open(MODEL_DB_NAME, MODEL_DB_VER);
    req.onupgradeneeded = () => {
      if (!req.result.objectStoreNames.contains("models")) req.result.createObjectStore("models");
      if (!req.result.objectStoreNames.contains("ocr")) req.result.createObjectStore("ocr");
    };
    req.onsuccess = () => resolve(req.result);
    req.onerror = () => reject(req.error);
  });
}
function idbGetModel(key, store) {
  store = store || "models";
  return openModelDB().then(db => new Promise((resolve, reject) => {
    const r = db.transaction(store, "readonly").objectStore(store).get(key);
    r.onsuccess = () => { db.close(); resolve(r.result); };
    r.onerror = () => { db.close(); reject(r.error); };
  }));
}
function idbPutModel(key, data, store) {
  store = store || "models";
  return openModelDB().then(db => new Promise((resolve, reject) => {
    const tx = db.transaction(store, "readwrite");
    tx.objectStore(store).put(data, key);
    tx.oncomplete = () => { db.close(); resolve(); };
    tx.onerror = () => { db.close(); reject(tx.error); };
  }));
}
/* ===== 识别结果缓存：同一张图（内容指纹相同）再次处理时直接复用文字结果，跳过模型 ===== */
function ocrCacheKey(p) {
  return "ocr:" + p.hash + ":" + p.w + "x" + p.h;
}
async function ocrCacheGet(p) {
  if (!p.hash) return null;
  try {
    const hit = await idbGetModel(ocrCacheKey(p), "ocr");
    return (hit && Array.isArray(hit.lines)) ? hit.lines : null;
  } catch (e) { return null; }
}
function ocrCachePut(p, lines) {
  if (!p.hash || !lines) return;
  idbPutModel(ocrCacheKey(p), { w: p.w, h: p.h, lines }, "ocr").catch(() => {});
}
/* 尝试用缓存结果补齐照片识别：命中则填入 ocrWords 并重建框，返回 true */
async function applyCachedOcr(p) {
  if (p.ocrWords) return true;
  const lines = await ocrCacheGet(p);
  if (lines === null) return false;
  p.ocrWords = lines;
  p.ocrPasses = [{ pass: 1, scale: 1, enhance: false, lines: lines.map(l => l.text), words: lines }];
  p.recognized = true;
  buildBoxes(p);
  return true;
}
/* 取模型二进制：优先读本地缓存，缓存缺失时解码并写入缓存 */
async function loadModelBytes(name, gzB64) {
  const key = MODEL_CACHE_VER + ":" + name;
  S.modelLoadInfo = S.modelLoadInfo || {};
  try {
    const hit = await idbGetModel(key);
    if (hit) { S.modelLoadInfo[name] = "cache"; return hit; }
  } catch (e) {}
  const ab = await inflateGz(await b64ToBytes(gzB64));
  S.modelLoadInfo[name] = "decode";
  try { await idbPutModel(key, ab); } catch (e) {}
  return ab;
}
function setEngineStatus(state, text) {
  const el = $("engineStatus");
  el.textContent = text;
  el.className = state;
  /* 引擎加载各阶段实时同步到处理遮罩，让用户看到进度在推进 */
  if (state === "busy" && !$("procOverlay").classList.contains("hidden")) updateProc(text);
}
/* 引擎失败时给出更详细的提示：帮助用户判断是内核兼容、内存还是缓存问题 */
function engineFailText(err) {
  const m = ((err && err.message) || err || "").toString();
  let hint;
  if (/onnxruntime 加载失败/.test(m)) {
    hint = "onnxruntime 脚本没能运行，浏览器可能禁用了内嵌脚本或内核不兼容。";
  } else if (/simd|thread|compile|wasm/i.test(m)) {
    hint = "浏览器内核对 WebAssembly 支持不完整，常见于夸克等第三方浏览器内核。";
  } else if (/memory|allocate|realloc/i.test(m)) {
    hint = "内存不足，请关闭其他标签页后重试。";
  } else if (/indexeddb|idb/i.test(m)) {
    hint = "本地缓存不可用（可能开了隐私模式/无痕）。";
  } else {
    hint = "暂时无法确认具体原因。";
  }
  return "识别引擎加载失败：" + hint + " 建议改用 Chrome 或手机自带浏览器（如 vivo 自带浏览器）打开本工具。" + (m ? "（原始错误：" + m + "）" : "");
}
async function initEngine() {
  if (S.engine) return S.engine;
  if (S.engineLoading) return S.engineLoading;
  S.engineLoading = (async () => {
    setEngineStatus("busy", "正在初始化识别引擎…");
    try {
      // 1) 取 wasm -> blob URL（onnxruntime-web 在 worker 中按文件名 fetch，全部映射到同一 URL）
      const wasmAb = await loadModelBytes("wasm", ORT_WASM_GZ);
      const wasmUrl = URL.createObjectURL(new Blob([wasmAb], { type: "application/wasm" }));
      // 2) 注入 onnxruntime.js
      const s = document.createElement("script");
      s.textContent = ORT_JS;
      document.body.appendChild(s);
      if (typeof ort === "undefined") throw new Error("onnxruntime 加载失败");
      ort.env.wasm.numThreads = 1;   // 强制单线程，避免手机浏览器多线程 wasm 崩溃
      ort.env.wasm.wasmPaths = {
        "ort-wasm.wasm": wasmUrl,
        "ort-wasm-simd.wasm": wasmUrl,
        "ort-wasm-simd-threaded.wasm": wasmUrl,
        "ort-wasm-simd-threaded.jsep.wasm": wasmUrl,
      };
      // 3) 检测/识别两个模型并行加载（各自的取数据/解析交错执行，整体省时）
      setEngineStatus("busy", "正在并行加载检测/识别模型…");
      await yieldUi();   // 先绘制状态文字，再做耗时的模型解析
      const loadDet = (async () => {
        const s = await ort.InferenceSession.create(await loadModelBytes("det", DET_ONNX_GZ), { executionProviders: ["wasm"] });
        return { s, in: s.inputNames[0], out: s.outputNames[0] };
      })();
      const loadRec = (async () => {
        const s = await ort.InferenceSession.create(await loadModelBytes("rec", REC_ONNX_GZ), { executionProviders: ["wasm"] });
        return { s, in: s.inputNames[0], out: s.outputNames[0] };
      })();
      const detR = await loadDet, recR = await loadRec;
      S.detSession = detR.s; S.detIn = detR.in; S.detOut = detR.out;
      S.recSession = recR.s; S.recIn = recR.in; S.recOut = recR.out;
      S.engine = true;
      /* 显示模型数据来源：cache=从本地缓存秒读；decode=缓存不可用/首次，重新解压了 20MB */
      const info = S.modelLoadInfo || {};
      const miss = Object.keys(info).length === 3 && ["wasm", "det", "rec"].every(n => info[n] === "decode");
      setEngineStatus("ready", miss ? "引擎已就绪（本地缓存不可用，每次需重新解码模型）" : "引擎已就绪（模型数据已缓存）");
      return S.engine;
    } catch (err) {
      console.error(err);
      setEngineStatus("err", engineFailText(err));
      throw err;
    } finally {
      S.engineLoading = null;
    }
  })();
  return S.engineLoading;
}

/* ================= 照片管理 ================= */
function addPhotos(fileList) {
  let ignored = 0;
  for (const file of fileList) {
    if (!file.type.startsWith("image/")) { ignored++; continue; }
    const url = URL.createObjectURL(file);
    const img = new Image();
    img.onload = () => {
      /* 计算图片内容指纹（采样 32x32 像素哈希），用于识别结果缓存 */
      let hash = "";
      try {
        const hc = document.createElement("canvas");
        hc.width = 32; hc.height = 32;
        const hg = hc.getContext("2d");
        hg.drawImage(img, 0, 0, 32, 32);
        const hd = hg.getImageData(0, 0, 32, 32).data;
        let h = 5381;
        for (let i = 0; i < hd.length; i += 8) h = ((h << 5) + h + hd[i] * 31 + hd[i + 1]) >>> 0;
        hash = h.toString(36);
      } catch (e) {}
      S.photos.push({ id: Date.now() + Math.random(), img, hash, name: file.name || "photo.jpg", w: img.naturalWidth, h: img.naturalHeight, boxes: [], recognized: false });
      renderThumbs();
    };
    img.onerror = () => URL.revokeObjectURL(url);
    img.src = url;
  }
  if (ignored) toast("已忽略 " + ignored + " 个非图片文件");
}
function renderThumbs() {
  const wrap = $("thumbList");
  wrap.innerHTML = "";
  S.photos.forEach((p, i) => {
    const d = document.createElement("div");
    d.className = "th" + (i === S.cur ? " cur" : "");
    d.innerHTML = `<img src="${p.img.src}"><div class="tag">${p.name}</div><button class="rm">×</button>`;
    d.querySelector(".rm").onclick = (e) => { e.stopPropagation(); removePhoto(i); };
    d.onclick = () => { S.cur = i; renderThumbs(); };
    wrap.appendChild(d);
  });
  /* 已选数量提示：引导逐张追加 */
  const hint = $("thumbsHint");
  if (hint) {
    hint.textContent = S.photos.length ? `已选 ${S.photos.length} 张照片 · 可继续点「📁 从相册选择」追加` : "";
  }
}
function removePhoto(i) {
  S.photos.splice(i, 1);
  if (S.cur >= S.photos.length) S.cur = S.photos.length - 1;
  if (S.cur === i) S.cur = Math.min(i, S.photos.length - 1);
  renderThumbs();
  if (S.previewOn) renderPreview();   // 第一张被删时 renderPreview 内部会自动收起
}

/* ================= 画布渲染 ================= */
const canvas = $("editor");
const ctx = canvas.getContext("2d");

function fitTransform() {
  const wrap = $("canvasWrap");
  const cw = wrap.clientWidth;
  const p = curPhoto();
  if (!p) return;
  const scale = cw / p.w;
  S.fitScale = scale;
  S.zoom = { scale, ox: 0, oy: 0 };
}
function curPhoto() { return S.photos[S.cur] || null; }
function resetCanvas() {
  const p = curPhoto();
  const wrap = $("canvasWrap");
  if (!p) return;
  fitTransform();
  canvas.width = wrap.clientWidth;
  canvas.height = Math.max(200, Math.round(p.h * S.zoom.scale));
  canvas.style.height = canvas.height + "px";
  S.boxes = p.boxes;
  S.kwWmSel = -1;   // 切换照片时清空水印框选中
  draw();
}
function draw() {
  const p = curPhoto();
  if (!p) return;
  ctx.clearRect(0, 0, canvas.width, canvas.height);
  const { scale, ox, oy } = S.zoom;
  // 背景
  ctx.fillStyle = "#0f1115";
  ctx.fillRect(0, 0, canvas.width, canvas.height);
  // 绘制原图（屏幕空间全图缩放，GPU 加速）
  ctx.drawImage(p.img, 0, 0, p.w, p.h, ox, oy, p.w * scale, p.h * scale);
  // 识别文字叠加模式：只显示原图 + 识别词，不画马赛克/水印/框
  if (S.ocrMode) {
    drawOcrOverlay(p, scale, ox, oy);
    return;
  }
  // 打码预览（屏幕空间）
  for (let i = 0; i < p.boxes.length; i++) {
    if (p.boxes[i].skip) continue;
    const b = boxToScreen(p.boxes[i]);
    applyMaskScreen(b);
  }
  // 水印预览
  drawWatermarkScreen();
  // 关键词水印预览（含选中框描边）
  drawKwWmPreview();
  // 绘制框
  for (let i = 0; i < p.boxes.length; i++) {
    if (p.boxes[i].skip) continue;
    const b = boxToScreen(p.boxes[i]);
    ctx.strokeStyle = i === S.sel ? "#22c55e" : "#ef4444";
    ctx.lineWidth = i === S.sel ? 2.5 : 1.5;
    ctx.strokeRect(b.x + 0.5, b.y + 0.5, Math.max(1, b.w - 1), Math.max(1, b.h - 1));
    if (i === S.sel) {
      ctx.strokeStyle = "#22c55e";
      const hs = 8;
      const pts = [[b.x, b.y], [b.x + b.w, b.y], [b.x, b.y + b.h], [b.x + b.w, b.y + b.h]];
      for (const [hx, hy] of pts) {
        ctx.fillStyle = "#22c55e";
        ctx.fillRect(hx - hs / 2, hy - hs / 2, hs, hs);
      }
      ctx.fillStyle = "rgba(34,197,94,.08)";
      ctx.fillRect(b.x, b.y, b.w, b.h);
    }
  }
  // 加框模式提示
  if (S.addMode) {
    ctx.fillStyle = "rgba(255,255,255,.85)";
    ctx.font = "12px sans-serif";
    ctx.fillText("在图上拖动框住价格区域", 10, 18);
  }
}
function boxToScreen(b) {
  const { scale, ox, oy } = S.zoom;
  return { x: b.x * scale + ox, y: b.y * scale + oy, w: b.w * scale, h: b.h * scale };
}
function mosaicScreen(b, bs) {
  bs = Math.max(3, bs);
  ctx.save();
  ctx.beginPath();
  ctx.rect(b.x, b.y, b.w, b.h);
  ctx.clip();
  ctx.imageSmoothingEnabled = false;
  const cols = Math.max(1, Math.round(b.w / bs));
  const rows = Math.max(1, Math.round(b.h / bs));
  ctx.drawImage(canvas, b.x, b.y, b.w, b.h, b.x, b.y, cols, rows);
  ctx.drawImage(canvas, b.x, b.y, cols, rows, b.x, b.y, b.w, b.h);
  ctx.restore();
}
/* 高斯模糊能力检测：部分老安卓内核不支持 ctx.filter，不支持时自动回退马赛克 */
const FILTER_OK = (() => {
  try {
    const c = document.createElement("canvas").getContext("2d");
    c.filter = "blur(1px)";
    return c.filter === "blur(1px)";
  } catch (e) { return false; }
})();
/* 打码渲染（屏幕预览版）：blur=高斯模糊 / solid=纯色块 / img=图片素材 / mosaic=马赛克 */
function applyMaskScreen(b) {
  const s = S.settings;
  const t = s.maskType || "mosaic";
  if (t === "blur" && FILTER_OK) {
    const r = Math.max(1, (s.maskBlur != null ? s.maskBlur : 12) * S.zoom.scale);
    ctx.save();
    ctx.filter = "blur(" + r + "px)";
    ctx.beginPath();
    ctx.rect(b.x, b.y, b.w, b.h);
    ctx.clip();
    ctx.drawImage(canvas, b.x, b.y, b.w, b.h, b.x, b.y, b.w, b.h);
    ctx.restore();
    return;
  }
  if (t === "solid") {
    ctx.save();
    ctx.globalAlpha = s.maskSolidOpacity != null ? s.maskSolidOpacity : 1;
    ctx.fillStyle = s.maskSolidColor || "#000000";
    ctx.fillRect(b.x, b.y, b.w, b.h);
    ctx.restore();
    return;
  }
  if (t === "img" && imgReady(S.maskImgEl, s.maskImgData)) {
    const img = S.maskImgEl;
    const zs = (S.zoom && S.zoom.scale) || 1;
    /* 要多大就裁多大：按打码框的真实大小（世界坐标）从素材里裁一块，放大框=裁更大的区域 */
