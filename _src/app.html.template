<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<title>价格打码 · 水印工具</title>
<style>
:root{
  --green:#16a34a; --green-d:#15803d; --bg:#f4f6f5; --card:#fff;
  --txt:#1f2937; --mut:#6b7280; --line:#e5e7eb; --red:#dc2626; --blue:#2563eb;
}
*{box-sizing:border-box; -webkit-tap-highlight-color:transparent;}
html,body{margin:0; padding:0;}
body{
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif;
  background:var(--bg); color:var(--txt); font-size:15px;
  padding-bottom:env(safe-area-inset-bottom);
  overflow-x:hidden;
}
button{font-family:inherit; cursor:pointer;}
.hidden{display:none!important;}
/* ---------- header ---------- */
header{
  display:flex; align-items:center; justify-content:space-between;
  padding:14px 16px; background:var(--card); border-bottom:1px solid var(--line);
  position:sticky; top:0; z-index:50;
}
.brand{font-weight:700; font-size:17px;}
.brand span{color:var(--green);}
#btnExport{border:1px solid var(--line); background:#fff; color:var(--txt); border-radius:8px;
  font-size:12px; padding:5px 10px; flex:none;}
#engineStatus{
  font-size:12px; color:var(--mut); display:flex; align-items:center; gap:6px;
}
#engineStatus::before{
  content:""; width:8px; height:8px; border-radius:50%; background:#d1d5db; flex:none;
}
#engineStatus.ready::before{background:var(--green);}
#engineStatus.err::before{background:var(--red);}
#engineStatus.busy::before{background:#f59e0b; animation:blink 1s infinite;}
@keyframes blink{50%{opacity:.3;}}
/* ---------- steps ---------- */
.steps{
  display:flex; background:var(--card); border-bottom:1px solid var(--line);
  position:sticky; top:52px; z-index:40;
}
.steps .step{
  flex:1; text-align:center; padding:10px 0 8px; font-size:13px; color:var(--mut);
  border-bottom:3px solid transparent;
}
.steps .step.active{color:var(--green); border-bottom-color:var(--green); font-weight:600;}
/* ---------- sections ---------- */
section{max-width:720px; margin:0 auto; padding:16px;}
.card{background:var(--card); border-radius:14px; padding:16px; margin-bottom:16px;
  box-shadow:0 1px 3px rgba(0,0,0,.06);}
.card h3{margin:0 0 12px; font-size:15px;}
.btn{
  display:block; width:100%; border:none; border-radius:12px; padding:14px;
  font-size:16px; font-weight:600; text-align:center; background:var(--green); color:#fff;
}
.btn.ghost{background:#eef2f0; color:var(--txt);}
.btn.sec{background:#fff; color:var(--txt); border:1px solid var(--line);}
.btn:disabled{opacity:.45; cursor:not-allowed;}
.btn + .btn{margin-top:10px;}
.hint{color:var(--mut); font-size:12px; text-align:center; margin:10px 0 0;}
/* thumbs */
.thumbs{display:grid; grid-template-columns:repeat(3,1fr); gap:8px; margin-bottom:16px;}
#thumbsHint{color:var(--green); font-size:12px; text-align:center; margin:0 0 8px;}
.thumbs .th{position:relative; border-radius:10px; overflow:hidden; border:2px solid transparent;}
.thumbs .th img{width:100%; height:96px; object-fit:cover; display:block; background:#eee;}
.thumbs .th .tag{
  position:absolute; left:0; right:0; bottom:0; background:rgba(0,0,0,.55); color:#fff;
  font-size:11px; padding:2px 6px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
}
.thumbs .th .rm{
  position:absolute; top:4px; right:4px; width:22px; height:22px; border-radius:50%;
  background:rgba(0,0,0,.55); color:#fff; border:none; font-size:13px; line-height:1;
}
.thumbs .th.cur{border-color:var(--green);}
/* progress */
.bar{background:#e5e7eb; border-radius:8px; height:10px; overflow:hidden; margin:12px 0 6px;}
.bar>div{height:100%; width:0; background:var(--green); border-radius:8px; transition:width .2s;}
#progressText{font-size:13px; color:var(--mut); text-align:center;}
/* 处理中全屏遮罩：点击后立即出现，避免识别耗时期间误以为卡死 */
#procOverlay{position:fixed; inset:0; z-index:300; display:flex; align-items:center; justify-content:center;}
#procMask{position:absolute; inset:0; background:rgba(0,0,0,.55);}
#procBox{position:relative; width:min(320px,82vw); background:var(--card); border-radius:16px;
  padding:28px 22px 22px; text-align:center; box-shadow:0 10px 34px rgba(0,0,0,.3);}
#procSpin{width:46px; height:46px; border:4px solid var(--line); border-top-color:var(--green);
  border-radius:50%; margin:0 auto 16px; animation:spin 1s linear infinite;}
@keyframes spin{to{transform:rotate(360deg);}}
#procText{font-size:14px; color:var(--txt); margin-bottom:14px; word-break:break-all; line-height:1.4;}
#procOverlay .bar{background:#e5e7eb; border-radius:8px; height:8px; overflow:hidden; margin:0;}
#procBar{height:100%; width:0; background:var(--green); border-radius:8px; transition:width .2s;}
/* editor canvas */
.canvas-wrap{
  position:relative; background:#0f1115; border-radius:14px; overflow:hidden;
  margin-bottom:10px; touch-action:none;
}
#editor{display:block; width:100%; touch-action:none;}
#zoomBtns{
  position:absolute; right:8px; top:8px; display:flex; flex-direction:column; gap:6px; z-index:5;
}
#zoomBtns button{
  width:38px; height:38px; border-radius:10px; border:none; background:rgba(255,255,255,.92);
  font-size:17px; font-weight:700; color:var(--txt); box-shadow:0 1px 3px rgba(0,0,0,.3);
}
#delFloat{
  position:absolute; top:8px; left:50%; transform:translateX(-50%); z-index:5;
  background:var(--red); color:#fff; border:none; border-radius:20px; padding:8px 16px;
  font-size:13px; font-weight:600; box-shadow:0 2px 6px rgba(0,0,0,.3);
}
/* toolbar */
.toolbar{display:flex; gap:8px; margin-bottom:10px;}
.toolbar .btn{flex:1; padding:10px; font-size:14px;}
/* box list */
.boxlist{margin:10px 0;}
.bi{
  display:flex; align-items:center; gap:8px; background:var(--card); border-radius:10px;
  padding:8px 12px; margin-bottom:6px; border:1px solid var(--line);
}
.bi .chk{width:20px; height:20px; accent-color:var(--green); flex:none;}
.bi .nm{flex:1; font-size:14px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;}
.bi .sz{color:var(--mut); font-size:12px; flex:none;}
/* settings */
.set{display:flex; align-items:center; gap:10px; margin-bottom:12px;}
.set label{flex:none; width:64px; color:var(--mut); font-size:13px;}
.set input[type=range]{flex:1;}
.set input[type=text], .set select{
  flex:1; border:1px solid var(--line); border-radius:8px; padding:8px; font-size:15px; min-width:0;
}
.set .val{flex:none; width:44px; text-align:right; color:var(--mut); font-size:12px;}
.set input[type=color]{width:44px; height:32px; border:none; background:none; padding:0; flex:none;}
label.switch{position:relative; width:44px; height:26px; flex:none; cursor:pointer;}
.switch input{position:absolute; opacity:0; width:0; height:0; pointer-events:none;}
.switch .sl{
  position:absolute; inset:0; background:#d1d5db; border-radius:26px; transition:.2s;
}
.switch .sl::before{
  content:""; position:absolute; width:20px; height:20px; border-radius:50%;
  background:#fff; top:3px; left:3px; transition:.2s;
}
.switch input:checked + .sl{background:var(--green);}
.switch input:checked + .sl::before{transform:translateX(18px);}
.pos9{display:grid; grid-template-columns:repeat(3,1fr); gap:6px; margin-bottom:4px;}
.pos9 button{
  padding:8px 0; border-radius:8px; border:1px solid var(--line); background:#fff; font-size:12px;
  color:var(--mut);
}
.pos9 button.on{border-color:var(--green); color:var(--green); background:#f0fdf4; font-weight:600;}
.palette{display:flex; gap:6px; flex-wrap:wrap;}
.palette button{
  width:26px; height:26px; border-radius:50%; border:2px solid #fff; box-shadow:0 0 0 1px var(--line);
}
/* image watermark preview */
#wmImgPreviewWrap, #kwWmImgPreviewWrap{position:relative; margin-bottom:10px;}
#wmImgPreview, #kwWmImgPreview, #maskImgPreview{width:100%; height:110px; border:1px solid var(--line); border-radius:10px; display:block;}
#wmImgRemove, #kwWmImgRemove{
  position:absolute; top:4px; right:4px; width:24px; height:24px; border-radius:50%;
  border:none; background:rgba(0,0,0,.6); color:#fff; font-size:13px; line-height:1;
}
/* keyword list */
.kw-tip{font-size:12px; color:var(--mut); margin-bottom:8px;}
#kwList{margin-bottom:8px;}
.kw-row{display:flex; align-items:center; flex-wrap:wrap; gap:6px; padding:6px 0; border-bottom:1px dashed var(--line);}
.kw-row:last-child{border-bottom:none;}
.kw-row .kw-txt{flex:1; font-size:14px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;}
.kw-row .mini-btn{margin-left:0; padding:3px 8px;}
.mini-btn.on{background:var(--green); border-color:var(--green); color:#fff;}
.mini-btn.del{color:#dc2626; border-color:#fca5a5;}
#kwInput{flex:1; min-width:0;}
#kwAdd.kw-add{margin-left:8px; flex:none; padding:8px 14px;}
/* step nav */
.nav{display:flex; gap:10px; margin-top:6px;}
.nav .btn{flex:1;}
#schemeBtns .btn{flex:1 1 30%; padding:10px; font-size:13px;}
#schemeBtns .btn.on{border-color:var(--green); color:var(--green); background:#f0fdf4; font-weight:600;}
/* toast */
#toast{
  position:fixed; left:50%; bottom:90px; transform:translateX(-50%) translateY(20px);
  background:rgba(17,24,39,.92); color:#fff; padding:10px 18px; border-radius:10px;
  font-size:14px; opacity:0; pointer-events:none; transition:.25s; z-index:99; max-width:86vw;
  text-align:center;
}
#toast.show{opacity:1; transform:translateX(-50%) translateY(0);}
.loading-msg{text-align:center; color:var(--mut); font-size:13px; padding:8px 0;}
/* OCR 文字查看弹层 */
.mini-btn{margin-left:8px; padding:2px 10px; border:1px solid var(--mut); border-radius:6px; background:none; color:inherit; font-size:12px; cursor:pointer;}
#ocrOverlay{position:fixed; inset:0; z-index:98; display:flex; align-items:center; justify-content:center;}
#ocrOverlay.hidden{display:none;}
#ocrMask{position:absolute; inset:0; background:rgba(0,0,0,.5);}
#ocrPanel{position:relative; width:88vw; max-width:560px; max-height:76vh; display:flex; flex-direction:column;
  background:var(--bg); border:1px solid var(--bd); border-radius:12px; overflow:hidden;}
#ocrHead{display:flex; align-items:center; justify-content:space-between; padding:10px 14px; border-bottom:1px solid var(--bd);}
#ocrHead b{font-size:14px; color:var(--tx); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;}
#ocrClose{border:none; background:none; font-size:18px; color:var(--mut); cursor:pointer; padding:0 4px;}
#ocrBody{flex:1; overflow:auto; padding:12px 14px; margin:0; white-space:pre-wrap; word-break:break-all;
  font:13px/1.7 ui-monospace, Menlo, Consolas, monospace; color:var(--tx);}
#ocrBody .ph{color:var(--mut); font-family:inherit;}
.btnrow{display:flex; gap:8px; margin-bottom:8px;}
.btnrow .btn{margin-top:0;}
/* 方案改名弹层 */
#renameModal{position:fixed; inset:0; z-index:98; display:flex; align-items:center; justify-content:center;}
#renameModal.hidden{display:none;}
#renameMask{position:absolute; inset:0; background:rgba(0,0,0,.5);}
#renamePanel{position:relative; width:88vw; max-width:300px; max-height:70vh; overflow-y:auto; background:var(--bg); border:1px solid var(--bd);
  border-radius:12px; padding:12px; box-sizing:border-box;}
#renameHead{display:flex; align-items:center; justify-content:space-between; margin-bottom:10px;}
#renameHead b{font-size:14px; color:var(--tx);}
#renameClose{border:none; background:none; font-size:18px; color:var(--mut); cursor:pointer; padding:0 4px;}
#renamePanel .set{margin-bottom:8px;}
#renamePanel .set label{width:48px; font-size:13px;}
#renamePanel .set input{font-size:13px; padding:8px 10px;}
#renamePanel .nav{margin-top:10px;}
/* 复制方案弹层 */
#copyModal{position:fixed; inset:0; z-index:98; display:flex; align-items:center; justify-content:center;}
#copyModal.hidden{display:none;}
#copyMask{position:absolute; inset:0; background:rgba(0,0,0,.5);}
#copyPanel{position:relative; width:84vw; max-width:300px; background:var(--bg); border:1px solid var(--bd);
  border-radius:12px; padding:12px; box-sizing:border-box;}
#copyHead{display:flex; align-items:center; justify-content:space-between; margin-bottom:8px;}
#copyHead b{font-size:14px; color:var(--tx);}
#copyClose{border:none; background:none; font-size:18px; color:var(--mut); cursor:pointer; padding:0 4px;}
#copyDesc{margin:0 0 8px; color:var(--mut); font-size:13px;}
#copyTargets .kw-row input{width:18px; height:18px; accent-color:var(--green); flex:none;}
#copyTargets .kw-row{margin-bottom:2px;}
/* 导出设置弹层 */
#exportModal{position:fixed; inset:0; z-index:98; display:flex; align-items:center; justify-content:center;}
#exportModal.hidden{display:none;}
#exportMask{position:absolute; inset:0; background:rgba(0,0,0,.5);}
#exportPanel{position:relative; width:88vw; max-width:420px; background:var(--bg); border:1px solid var(--bd);
  border-radius:12px; padding:12px; box-sizing:border-box;}
#exportHead{display:flex; align-items:center; justify-content:space-between; margin-bottom:8px;}
#exportHead b{font-size:14px; color:var(--tx);}
#exportClose{border:none; background:none; font-size:18px; color:var(--mut); cursor:pointer; padding:0 4px;}
#exportText{width:100%; height:130px; box-sizing:border-box; border:1px solid var(--line); border-radius:8px;
  padding:8px; font:12px/1.5 ui-monospace, Menlo, Consolas, monospace; color:var(--tx);
  resize:none; overflow:auto; background:#fff; word-break:break-all;}
#kwWmDlg{position:fixed; inset:0; z-index:98; display:flex; align-items:center; justify-content:center;}
#kwWmDlg.hidden{display:none;}
#kwWmMask{position:absolute; inset:0; background:rgba(0,0,0,.5);}
#kwWmPanel{position:relative; width:88vw; max-width:420px; background:var(--bg); border:1px solid var(--bd);
  border-radius:12px; padding:12px; box-sizing:border-box;}
#kwWmHead{display:flex; align-items:center; justify-content:space-between; margin-bottom:8px;}
#kwWmHead b{font-size:14px; color:var(--tx);}
#kwWmClose{border:none; background:none; font-size:18px; color:var(--mut); cursor:pointer; padding:0 4px;}
#previewCanvas{width:100%; border:1px solid var(--line); border-radius:8px; background:#fff; box-sizing:border-box;}
#saveModal{position:fixed; inset:0; z-index:98; display:flex; align-items:center; justify-content:center;}
#saveModal.hidden{display:none;}
#saveMask{position:absolute; inset:0; background:rgba(0,0,0,.5);}
#savePanel{position:relative; width:86vw; max-width:400px; background:var(--bg); border:1px solid var(--bd);
  border-radius:12px; padding:14px; box-sizing:border-box;}
#saveHead{display:flex; align-items:center; justify-content:space-between; margin-bottom:4px;}
#saveHead b{font-size:14px; color:var(--tx);}
#saveText{margin:8px 0 4px; font-size:13px; color:var(--tx); word-break:break-all;}
#saveBar{background:var(--green); border-radius:8px; height:100%; width:0%; transition:width .15s;}
#importModal{position:fixed; inset:0; z-index:98; display:flex; align-items:center; justify-content:center;}
#importModal.hidden{display:none;}
#importMask{position:absolute; inset:0; background:rgba(0,0,0,.5);}
#importPanel{position:relative; width:88vw; max-width:420px; background:var(--bg); border:1px solid var(--bd);
  border-radius:12px; padding:12px; box-sizing:border-box;}
#importHead{display:flex; align-items:center; justify-content:space-between; margin-bottom:8px;}
#importHead b{font-size:14px; color:var(--tx);}
#importClose{border:none; background:none; font-size:18px; color:var(--mut); cursor:pointer; padding:0 4px;}
#importText{width:100%; height:130px; box-sizing:border-box; border:1px solid var(--line); border-radius:8px;
  padding:8px; font:12px/1.5 ui-monospace, Menlo, Consolas, monospace; color:var(--tx);
  resize:none; overflow:auto; background:#fff; word-break:break-all;}
</style>
</head>
<body>

<header>
  <div class="brand">价格打码<span>·</span>水印工具</div>
  <div style="display:flex; align-items:center; gap:10px;">
    <div id="engineStatus">引擎未加载</div>
    <button id="btnImport" title="导入设置（换浏览器/换手机后恢复）">⬆ 导入</button>
    <button id="btnExport" title="导出当前全部设置">⬇ 导出</button>
  </div>
</header>

<nav class="steps">
  <div class="step active" data-s="1">1 选图设置</div>
  <div class="step" data-s="2">2 识别打码</div>
  <div class="step" data-s="3">3 微调保存</div>
</nav>

<!-- ============ 步骤1 选图 + 设置 ============ -->
<section id="sec1">
  <div class="card">
    <button class="btn" id="btnPick">📁 从相册选择照片</button>
    <button class="btn ghost" id="btnCamera">📷 拍照</button>
    <p class="hint">点击后会打开文件管理器，进入「图片/相册/DCIM」文件夹即可勾选多张图片；也可重复选择追加。选好后点「开始识别并打码」，完成后自动进入微调保存。</p>
  </div>
  <div class="card">
    <button class="btn sec" id="btnPreview">👁 预览效果（识别第一张图）</button>
    <p class="hint">点一次只识别第一张图作为样板，之后改下面的任何设置都会实时反映在这张图上；参数满意后再点「开始识别并打码」处理所有图片。</p>
    <div id="previewWrap" class="hidden">
      <canvas id="previewCanvas"></canvas>
      <div style="display:flex; align-items:center; gap:8px; margin-top:6px;">
        <b style="flex:1; font-size:14px;">实时预览（第一张图）</b>
        <button class="mini-btn" id="btnPreviewClose">收起</button>
      </div>
      <p class="kw-tip" style="margin:6px 0 0;">改任何设置都会自动重新标记并刷新预览，无需手动操作。</p>
    </div>
  </div>
  <div id="thumbsHint"></div>
  <div class="thumbs" id="thumbList"></div>

  <div class="card">
    <h3>📋 方案（一键切换并保存设置）</h3>
    <div id="schemeBtns" style="display:flex; flex-wrap:wrap; gap:8px; margin-bottom:8px;"></div>
    <div class="btnrow">
      <button class="btn sec" id="btnAddScheme">＋ 新增方案</button>
      <button class="btn sec" id="btnDelScheme">🗑 删除当前</button>
    </div>
    <div class="btnrow">
      <button class="btn sec" id="btnSaveScheme" style="white-space:nowrap;">💾 保存到当前方案</button>
      <button class="btn sec" id="btnRenameScheme" style="white-space:nowrap;">✎ 改名</button>
    </div>
    <button class="btn sec" id="btnCopyScheme" style="margin-top:8px;">📋 复制当前方案到其他方案</button>
  </div>

  <div class="card">
    <h3>🫧 打码设置</h3>
    <div class="set">
      <label>方式</label>
      <div style="flex:1; display:flex; gap:8px;">
        <button class="mini-btn" id="maskTypeMosaic">马赛克</button>
        <button class="mini-btn" id="maskTypeBlur">模糊</button>
        <button class="mini-btn" id="maskTypeSolid">色块</button>
        <button class="mini-btn" id="maskTypeImg">图片</button>
      </div>
    </div>
    <div id="maskMosaicSet" class="hidden">
      <div class="set">
        <label>块大小</label>
        <input type="range" id="mosaicSize" min="4" max="64" step="1">
        <span class="val" id="mosaicSizeVal"></span>
      </div>
    </div>
    <div id="maskBlurSet" class="hidden">
      <div class="set">
        <label>模糊强度</label>
        <input type="range" id="maskBlur" min="1" max="40" step="1">
        <span class="val" id="maskBlurVal"></span>
      </div>
      <p class="kw-tip" style="margin:0;">强度越大越糊，参考你手上的模糊示例图调整。</p>
    </div>
    <div id="maskSolidSet" class="hidden">
      <div class="set">
        <label>颜色</label>
        <input type="color" id="maskSolidColor" value="#000000">
      </div>
      <div class="set">
        <label>不透明度</label>
        <input type="range" id="maskSolidOpacity" min="0.2" max="1" step="0.05">
        <span class="val" id="maskSolidOpacityVal"></span>
      </div>
    </div>
    <div id="maskImgSet" class="hidden">
      <p class="kw-tip" style="margin:0 0 6px;">上传一张素材图（如你那张参考图），打码框多大就自动从素材里裁剪多大一块贴上去遮挡。</p>
      <div class="set">
        <label style="width:auto; margin-right:8px;">素材</label>
        <button class="btn sec" id="btnMaskImgUpload" style="padding:8px;">📁 选择素材图片</button>
        <input type="file" id="maskImgInput" accept="image/*" hidden>
      </div>
      <div id="maskImgArea" class="hidden">
        <div id="kwWmImgPreviewWrap" style="margin-bottom:0;">
          <canvas id="maskImgPreview"></canvas>
          <button id="maskImgRemove" title="移除打码素材">✕</button>
        </div>
      </div>
    </div>
  </div>

  <div class="card">
