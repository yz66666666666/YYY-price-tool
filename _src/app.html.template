/* 透明度预览：棋盘格背景上以当前透明度绘制上传图片 */
function updateWmImgPreview() {
  const cv = $("wmImgPreview");
  const img = S.wmImgEl;
  if (!cv) return;
  const W = 220, H = 110, cs = 12;
  cv.width = W; cv.height = H;
  const g = cv.getContext("2d");
  for (let y = 0; y < H; y += cs) {
    for (let x = 0; x < W; x += cs) {
      g.fillStyle = ((x / cs + y / cs) % 2 === 0) ? "#f2f2f2" : "#d0d0d0";
      g.fillRect(x, y, cs, cs);
    }
  }
  if (!img) {
    g.fillStyle = "#9ca3af";
    g.font = "13px sans-serif";
    g.textAlign = "center";
    g.fillText("未上传图片", W / 2, H / 2 + 4);
    return;
  }
  const op = S.settings.wmImg.opacity;
  const s = Math.min(W * 0.85 / img.width, H * 0.85 / img.height);
  const w = Math.round(img.width * s), h = Math.round(img.height * s);
  g.globalAlpha = op;
  g.drawImage(img, Math.round((W - w) / 2), Math.round((H - h) / 2), w, h);
  g.globalAlpha = 1;
}
/* 上传 PNG：缩放至最长边 512 后存 dataURL（便于持久化与方案保存） */
